---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HelpStyles from '../../components/HelpStyles.astro';
import HelpCentre from '../../islands/HelpCentre';
import { BY, PROBLEMS } from '../../data/help';

// FAQ structured data from the "Solve a problem" cards; each answer is the
// summary of the article the card links to.
const faq = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [...PROBLEMS.app, ...PROBLEMS.dash].map(([id, q]) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: `${BY[id].summary} Read more: https://joinnorma.com${BY[id].url}` },
  })),
};
---
<Layout title="Help centre · nørma" description="Help for the nørma app and the leader dashboard: check-ins, reflections, privacy, and reading the signal." canonical="https://joinnorma.com/help/" og skip>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faq)} />
  <div style="position:relative;overflow-x:clip;min-height:100vh;font-family:'DM Sans',sans-serif;color:#F4F2E6;background:#0A130D">
    <Header current="help" />
    <HelpCentre client:load view="home" />
    <div style="margin-top:110px"><Footer /></div>
  </div>
  <HelpStyles />
</Layout>
