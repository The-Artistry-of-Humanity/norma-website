---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HelpStyles from '../../../components/HelpStyles.astro';
import HelpCentre from '../../../islands/HelpCentre';
---
<Layout title="Search · nørma help" description="Search the nørma help centre." canonical="https://joinnorma.com/help/search/" noindex skip>
  <div style="position:relative;overflow-x:clip;min-height:100vh;font-family:'DM Sans',sans-serif;color:#F4F2E6;background:#0F2015">
    <Header current="help" />
    <HelpCentre client:load view="search" />
    <div style="margin-top:110px"><Footer /></div>
  </div>
  <HelpStyles />
</Layout>
