---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HelpCentre from '../../../islands/HelpCentre';
import { ALL, URL_SEGMENT } from '../../../data/help';

export function getStaticPaths() {
  return ALL.map((a) => ({ params: { path: URL_SEGMENT[a.path], slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
---
<Layout title={`${article.title} · nørma help`} description={article.summary} canonical={`https://joinnorma.com${article.url}`}>
  <div style="position:relative;overflow-x:clip;min-height:100vh;font-family:'DM Sans',sans-serif;color:#F4F2E6;background:#0A130D">
    <Header current="help" />
    <HelpCentre client:load view="article" path={article.path} id={article.id} />
    <Footer />
  </div>
  <style is:global>
    @media (max-width:1080px){[data-r=toc]{display:none!important}}
    @media (max-width:860px){[data-r=side]{display:none!important}[data-r=navlinks]{display:none!important}[data-r=mpath]{display:flex!important}}
    @media (max-width:560px){[data-r=topsearch]{display:none!important}}
  </style>
</Layout>
