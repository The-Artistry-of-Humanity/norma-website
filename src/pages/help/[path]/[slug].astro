---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HelpStyles from '../../../components/HelpStyles.astro';
import HelpCentre from '../../../islands/HelpCentre';
import { ALL, URL_SEGMENT, PATH_URL } from '../../../data/help';

export function getStaticPaths() {
  return ALL.map((a) => ({ params: { path: URL_SEGMENT[a.path], slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const base = 'https://joinnorma.com';
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: article.title, description: article.summary,
    mainEntityOfPage: base + article.url, inLanguage: 'en-AU', ...(article.updated ? { dateModified: article.updated } : {}),
    publisher: { '@type': 'Organization', name: 'The Artistry of Humanity Pty Ltd', url: base + '/' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Help centre', item: base + '/help/' },
      { '@type': 'ListItem', position: 2, name: article.pathLabel, item: base + PATH_URL[article.path] },
      { '@type': 'ListItem', position: 3, name: article.title, item: base + article.url },
    ],
  },
];
---
<Layout title={`${article.title} · nørma help`} description={article.summary} canonical={base + article.url} og skip>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <div style="position:relative;overflow-x:clip;min-height:100vh;font-family:'DM Sans',sans-serif;color:#F4F2E6;background:#0A130D">
    <Header current="help" />
    <HelpCentre client:load view="article" path={article.path} id={article.id} />
    <Footer />
  </div>
  <HelpStyles />
</Layout>
