---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found · nørma" noindex={true}>
  <div style="min-height:100vh;box-sizing:border-box;display:flex;flex-direction:column;background:radial-gradient(ellipse 60% 50% at 50% 40%,rgba(217,234,110,.08),rgba(0,0,0,0) 70%),linear-gradient(178deg,#17301F 0%,#0F2015 40%,#0A130D 100%);color:#F6F4E9">
    <div style="max-width:1180px;width:100%;margin:0 auto;padding:0 24px;height:68px;box-sizing:border-box;display:flex;align-items:center">
      <a href="/" style="display:flex;align-items:center;gap:10px"><img src="/assets/norma-logo.png" alt="" style="width:30px;height:30px;border-radius:9px" /><span style="font:400 23px 'DM Serif Display',serif;color:#F6F4E9">nørma</span></a>
    </div>
    <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 24px 100px">
      <span style="font:600 10px 'DM Sans',sans-serif;letter-spacing:2.4px;color:#D9EA6E">404 · PAGE NOT FOUND</span>
      <h1 style="margin:18px 0 0;max-width:620px;font:400 clamp(36px,5vw,56px)/1.08 'DM Serif Display',serif;letter-spacing:-.6px;text-wrap:pretty">This page is still being written.</h1>
      <p style="margin:18px 0 0;max-width:460px;font:400 17px/1.55 'DM Sans',sans-serif;color:rgba(201,212,194,.78);text-wrap:pretty">It will be here soon. In the meantime, the rest of nørma is one click away.</p>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:34px">
        <a href="/" class="hv-btn-primary-404" style="display:inline-flex;align-items:center;padding:15px 26px;border-radius:999px;background:linear-gradient(180deg,#E9F693,#D3E45F);font:600 15px 'DM Sans',sans-serif;color:#152213;box-shadow:inset 0 1px 0 rgba(255,255,255,.45),0 10px 30px rgba(217,234,110,.28);transition:all .2s ease">Back to nørma</a>
        <a href="https://calendar.app.google/P14aVTpPNqgrVAbHA" target="_blank" rel="noopener" class="hv-ghost" style="display:inline-flex;align-items:center;padding:15px 22px;border-radius:999px;border:1px solid rgba(228,240,214,.16);font:500 15px 'DM Sans',sans-serif;color:#F4F2E6;transition:all .2s ease">Book a demo</a>
      </div>
    </div>
  </div>
</Layout>
