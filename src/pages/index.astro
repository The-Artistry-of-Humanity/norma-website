  <script is:inline>
    (function () {
      var burger = document.getElementById('nrm-burger');
      var menu = document.getElementById('nrm-menu');
      var close = document.getElementById('nrm-menu-close');
      if (!burger || !menu || !close) return;
      function setOpen(open) {
        menu.hidden = !open;
        burger.setAttribute('aria-expanded', String(open));
        document.documentElement.style.overflow = open ? 'hidden' : '';
      }
      burger.addEventListener('click', function () { setOpen(menu.hidden); });
      close.addEventListener('click', function () { setOpen(false); });
      menu.addEventListener('click', function (e) {
        if (e.target === menu || (e.target instanceof Element && e.target.closest('a'))) setOpen(false);
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
    })();
  </script>
</Layout>
