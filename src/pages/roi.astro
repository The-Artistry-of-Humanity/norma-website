---
/* Round 5 page (handoff design_handoff_v5, 16 Oct 2026). The page is one React
   component generated from the reference: markup, styles and behaviour. */
import LayoutV5 from '../layouts/LayoutV5.astro';
import RoiPage from '../islands/v5/RoiPage';
---
<LayoutV5 title={'ROI · nørma'} description={'The human case and the business case are the same case. Work out what absence, presenteeism and turnover cost your organisation, and what nørma can win back.'} canonical="https://joinnorma.com/roi/" og="/og/roi.jpg">
  <RoiPage client:load />
</LayoutV5>
<style is:global>input[type=range]{accent-color:#D9EA6E}input::-webkit-outer-spin-button,input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}input[type=number]{-moz-appearance:textfield}
/* Headcount slider (added after the handoff): lime fill on a glass track, a
   dark knob with a lime centre like the dashboard dial's hub. --t is 0 to 1;
   the fill ends under the knob's centre. */
.nrm-range{-webkit-appearance:none;appearance:none;display:block;width:100%;height:36px;margin:0;padding:0;background:transparent;cursor:pointer;--k:30px;--h:12px}
.nrm-range-sm{height:30px;--k:24px;--h:8px}
.nrm-range::-webkit-slider-runnable-track{height:var(--h);border-radius:999px;background:linear-gradient(90deg,#CBDD55 0,#E4F38A calc(var(--k) / 2 + (100% - var(--k)) * var(--t)),rgba(255,255,255,.6) calc(var(--k) / 2 + (100% - var(--k)) * var(--t)));box-shadow:inset 0 1px 2px rgba(20,35,26,.16),inset 0 0 0 1px rgba(20,35,26,.1)}
.nrm-range::-moz-range-track{height:var(--h);border-radius:999px;background:linear-gradient(90deg,#CBDD55 0,#E4F38A calc(var(--k) / 2 + (100% - var(--k)) * var(--t)),rgba(255,255,255,.6) calc(var(--k) / 2 + (100% - var(--k)) * var(--t)));box-shadow:inset 0 1px 2px rgba(20,35,26,.16),inset 0 0 0 1px rgba(20,35,26,.1)}
.nrm-range::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;box-sizing:border-box;width:var(--k);height:var(--k);margin-top:calc((var(--h) - var(--k)) / 2);border:3px solid #F6F4E9;border-radius:52% 48% 50% 50% / 50% 54% 46% 50%;background:radial-gradient(circle,#D9EA6E 0 3px,rgba(217,234,110,0) 4px),radial-gradient(circle at 34% 28%,#2E4C36,#14231A 72%);box-shadow:0 6px 14px -3px rgba(20,35,26,.4),0 0 0 6px rgba(217,234,110,.3);transition:transform .2s cubic-bezier(.22,.61,.36,1),box-shadow .2s ease}
.nrm-range::-moz-range-thumb{box-sizing:border-box;width:var(--k);height:var(--k);border:3px solid #F6F4E9;border-radius:52% 48% 50% 50% / 50% 54% 46% 50%;background:radial-gradient(circle,#D9EA6E 0 3px,rgba(217,234,110,0) 4px),radial-gradient(circle at 34% 28%,#2E4C36,#14231A 72%);box-shadow:0 6px 14px -3px rgba(20,35,26,.4),0 0 0 6px rgba(217,234,110,.3);transition:transform .2s cubic-bezier(.22,.61,.36,1),box-shadow .2s ease}
.nrm-range-sm::-webkit-slider-thumb{border-width:2.5px;box-shadow:0 4px 10px -2px rgba(20,35,26,.4),0 0 0 4px rgba(217,234,110,.3)}
.nrm-range-sm::-moz-range-thumb{border-width:2.5px;box-shadow:0 4px 10px -2px rgba(20,35,26,.4),0 0 0 4px rgba(217,234,110,.3)}
.nrm-range:hover::-webkit-slider-thumb{box-shadow:0 6px 14px -3px rgba(20,35,26,.4),0 0 0 8px rgba(217,234,110,.38)}
.nrm-range:hover::-moz-range-thumb{box-shadow:0 6px 14px -3px rgba(20,35,26,.4),0 0 0 8px rgba(217,234,110,.38)}
.nrm-range:active::-webkit-slider-thumb{transform:scale(1.12)}
.nrm-range:active::-moz-range-thumb{transform:scale(1.12)}
.nrm-range:focus{outline:none}
.nrm-range:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 2px #14231A,0 0 0 6px #D9EA6E}
.nrm-range:focus-visible::-moz-range-thumb{box-shadow:0 0 0 2px #14231A,0 0 0 6px #D9EA6E}
.ri-hcnum:hover{border-bottom-color:rgba(20,35,26,.5)!important}
.ri-hcnum:focus{border-bottom-color:#4A6B3A!important;border-bottom-style:solid!important}
/* Phone pass (not in the handoff): one column of tall tier cards is a lot of
   scrolling for four numbers, so under 520px each becomes a row: the name with
   its share beneath on the left, the count on the right. */
@media (max-width:519px){
  [data-m=tiers]{gap:8px!important}
  [data-m=tiers] > div{display:grid!important;grid-template-columns:minmax(0,1fr) auto;column-gap:14px;row-gap:3px;align-items:center;padding:12px 12px 12px 18px!important}
  [data-m=tiers] > div > span:first-child{grid-column:1;grid-row:1;min-height:0!important;align-items:center!important}
  [data-m=tiers] > div > span:first-child > span:first-child{margin-top:0!important}
  [data-m=tiers] > div > span:last-child{display:contents!important}
  [data-m=tiers] > div > span:last-child > span:first-child{grid-column:2;grid-row:1 / span 2;min-width:40px;justify-content:center;padding:8px 14px!important}
  [data-m=tiers] > div > span:last-child > span:last-child{grid-column:1;grid-row:2;padding-left:17px}
}
</style>
