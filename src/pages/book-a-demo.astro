---
/* Round 5 page (handoff design_handoff_v5, 16 Oct 2026). The page is one React
   component generated from the reference: markup, styles and behaviour. */
import LayoutV5 from '../layouts/LayoutV5.astro';
import BookDemo from '../islands/v5/live/BookDemoLive';
import { FAQ } from '../islands/v5/BookDemo';
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<LayoutV5 title={'Book a demo · nørma employee wellbeing platform'} description={'Book a thirty-minute demo of nørma, the employee wellbeing app and culture dashboard, or tell us about your organisation and we’ll reply within one working day.'} canonical="https://joinnorma.com/book-a-demo/" jsonld={[faq]} og="/og/book-a-demo.jpg">
  <BookDemo client:load />
  <!-- Netlify Forms detects fields from static HTML at deploy time; the visible
       form is rendered by React and posts to this name (BookDemoLive.tsx). -->
  <form name="book-a-demo" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input name="bot-field" /><input name="name" /><input name="role" /><input name="phone" /><input name="email" />
    <input name="company" /><input name="country" /><input name="headcount" /><textarea name="message"></textarea>
  </form>
</LayoutV5>
<style is:global>input[type=range]{accent-color:#D9EA6E}::placeholder{color:rgba(20,35,26,.42);font-weight:400}input::-webkit-outer-spin-button,input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}input[type=number]{-moz-appearance:textfield}
/* Phone pass (not in the handoff): the copy takes the card's full width, nørma
   stands smaller beside the slot button, and the button stays on one line. */
@media (max-width:520px){
  [data-m=slot-btn]{white-space:nowrap}
  [data-m=slot-text]{padding-right:0!important}
  [data-m=slot-text] > p{padding-right:clamp(40px,14vw,72px)}
  [data-m=slot-norma]{width:96px!important;right:2px!important;bottom:-22px!important}
}
/* Thank-you button: one line always; on phones "Can't wait?" drops so it fits the card. */
[data-m=thanks-btn]{white-space:nowrap}
@media (max-width:419px){ .bd-cw{display:none} }
@media (max-width:300px){ [data-m=thanks-btn]{padding:0 18px!important;font-size:14px!important} }
/* Both cards use nearly the full width on a phone (10px gutters). */
@media (max-width:520px){
  [data-m=bd-cards]{width:calc(100% + 20px)!important;max-width:none!important;margin-left:-10px!important;margin-right:-10px!important}
  [data-m=bd-cards] > div:not([aria-hidden]){padding-left:22px!important;padding-right:22px!important}
}
@media (max-width:374px){
  [data-m=slot-btn]{padding:0 18px!important;gap:6px!important}
  [data-m=slot-norma]{width:78px!important;right:0!important;bottom:-18px!important}
}
</style>
