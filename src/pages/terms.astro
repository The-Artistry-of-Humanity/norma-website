---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LegalDoc from '../islands/LegalDoc';
---
<Layout title="Terms of use · nørma" description="The nørma Terms of use: the terms each person accepts when they create an account." canonical="https://joinnorma.com/terms/">
  <div style="position:relative;overflow-x:clip;font-family:'DM Sans',sans-serif;color:#F4F2E6;background:#0A130D;min-height:100vh">
    <Header />
    <LegalDoc doc="terms" />
    <Footer />
  </div>
  <style is:global>
    @media (max-width:900px){[data-r=side]{display:none!important}}
  </style>
</Layout>
