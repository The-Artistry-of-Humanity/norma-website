---
/* Round 5 page (handoff design_handoff_v5, 16 Oct 2026). The page is one React
   component generated from the reference: markup, styles and behaviour. */
import LayoutV5 from '../layouts/LayoutV5.astro';
import YourPeople from '../islands/v5/YourPeople';
---
<LayoutV5 title={'The nørma app · A private wellbeing companion for employees'} description={'A private wellbeing app for every employee: a monthly check-in across five pillars of a whole life, their own picture, and a companion for the moments in between.'} canonical="https://joinnorma.com/your-people/" og="/og/your-people.jpg">
  <script is:inline slot="head" src="/assets/v5/journey/ch00-film.js" defer></script>
  <YourPeople client:load />
</LayoutV5>
<style is:global>input[type=range]{accent-color:#14231A}
/* Phone pass (after the handoff): the check-in steps stack with a centred phone,
   so their headings and lines are centred too. */
@media (max-width:759px){
  [data-m=ci-steps] > li{text-align:center}
  [data-m=ci-steps] > li > div:first-child{justify-content:center}
  [data-m=ci-steps] > li > p{max-width:30em;margin-left:auto!important;margin-right:auto!important}
}
</style>
