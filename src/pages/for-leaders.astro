---
/* Round 5 page (handoff design_handoff_v5, 16 Oct 2026). The page is one React
   component generated from the reference: markup, styles and behaviour. */
import LayoutV5 from '../layouts/LayoutV5.astro';
import ForLeaders from '../islands/v5/ForLeaders';
---
<LayoutV5 title={'For leaders · nørma'} description={'The nørma dashboard brings Fulfilment and Culture together: where to look, what to do about it, and whether it worked. Group figures only.'} canonical="https://joinnorma.com/for-leaders/">
  <ForLeaders client:load />
</LayoutV5>
<style is:global>input[type=range]{accent-color:#14231A}
/* Phone pass (not in the handoff). Act on it: the chart is drawn 1000 units wide,
   so its 13-unit labels shrink to about 4px on a phone. Larger SVG text there,
   and the running label (which collides with the markers) is left to the list
   underneath, which says the same thing. */
@media (max-width:759px){
  [data-m=act-chart] text{font-size:34px}
  [data-m=act-label]{display:none}
}
</style>
