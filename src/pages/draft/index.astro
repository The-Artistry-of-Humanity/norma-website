---
/* DRAFT home page, 14 Oct 2026. Not linked from anywhere, noindex.
   Built to answer the 12 Oct client feedback: too agentic, too dark, too much,
   no clear why. The story is not new: it is the demo film's own spine
   (norma-demo-concept-2026-07-27.md), which the live site never tells.
   Palette rule: cream is the base, dark is punctuation for the product and the
   "before" moments. Nothing here touches the live pages. */
import Layout from '../../layouts/Layout.astro';
import Phone from '../../islands/Phone';

const INK = '#14231A';
const MUTED = 'rgba(20,35,26,.68)';
const CREAM = '#F4F2E6';
const CREAM_2 = '#EFEBDC';
const LIME = '#D9EA6E';

const wrap = 'max-width:1120px;margin:0 auto;padding-left:40px;padding-right:40px;box-sizing:border-box';
const h2 = `margin:0;font:400 clamp(30px,3.6vw,44px)/1.1 'DM Serif Display',serif;letter-spacing:-.6px;text-wrap:pretty`;
const lede = `font:400 18px/1.6 'DM Sans',sans-serif;text-wrap:pretty`;

// The film's cold open, scene 1: four everyday screens, four quiet cost words.
const pains = [
  { word: 'absent', cap: '11:52 PM, still scrolling', kind: 'lock' },
  { word: 'disengaged', cap: 'The "all good" that isn’t', kind: 'chat' },
  { word: 'quiet', cap: 'The meeting where nobody speaks', kind: 'meet' },
  { word: 'gone', cap: 'The resignation nobody saw coming', kind: 'mail' },
];

const appFeatures = [
  ['Check in', 'Twenty questions about a whole life, once a month.'],
  ['Reflect', 'Say it or type it. Nobody at work can read it.'],
  ['Reset', 'Breath work and short practices, picked by how you feel.'],
  ['Grow', 'Habits, illustrated chapters, one thing to try tonight.'],
];

const leaderFeatures = [
  ['Fulfilment and Culture', 'Two numbers for a group, with the months behind them.'],
  ['Focus area', 'The one thing to look at this month, and why.'],
  ['Growth work', 'Sessions to run, logged against what moved.'],
  ['Psychosocial duty', 'A dated record of what you saw and what you did.'],
];
---
<Layout title="nørma · draft home" description="Draft home page for review. Not public." noindex>
  <div style={`background:${CREAM};color:${INK};font-family:'DM Sans',sans-serif;overflow-x:clip`}>

    <div style="position:sticky;top:0;z-index:50;background:rgba(244,242,230,.84);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid rgba(20,35,26,.08)">
      <div style={`${wrap};height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px`}>
        <span style="display:flex;align-items:center;gap:10px">
          <img src="/assets/norma-logo.png" alt="" width="30" height="30" style="border-radius:9px" />
          <span style={`font:400 23px 'DM Serif Display',serif;color:${INK}`}>nørma</span>
        </span>
        <span style="display:flex;align-items:center;gap:26px">
          <span data-r="dnav" style={`display:flex;gap:26px;font:500 14px 'DM Sans',sans-serif;color:${MUTED}`}>
            <a href="#people" style={`color:${MUTED}`}>Your people</a>
            <a href="#leaders" style={`color:${MUTED}`}>For leaders</a>
            <a href="#promise" style={`color:${MUTED}`}>Privacy</a>
          </span>
          <a href="#demo" style={`display:inline-flex;align-items:center;padding:11px 20px;border-radius:999px;background:${INK};color:${CREAM};font:600 13.5px 'DM Sans',sans-serif`}>Book a demo</a>
        </span>
      </div>
    </div>

    <!-- 1 · Hero. The film's opening line, which says in one breath what the live
         hero never says: why nørma exists and why it has two sides. -->
    <section style={`${wrap};padding-top:clamp(64px,9vw,118px);padding-bottom:clamp(48px,6vw,84px)`}>
      <div style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(32px,5vw,72px);align-items:center" data-r="herogrid">
        <div>
          <h1 style={`margin:0;font:400 clamp(40px,5.6vw,68px)/1.02 'DM Serif Display',serif;letter-spacing:-1.2px;text-wrap:balance`}>
            Nobody leaves their life at the door. Nobody tells the truth at work.
          </h1>
          <p style={`margin:26px 0 0;max-width:30em;font:400 20px/1.55 'DM Sans',sans-serif;color:${MUTED};text-wrap:pretty`}>
            You pay for both, every day. nørma runs one loop, twice. Your people run it on their own
            fulfilment. You run it on your culture. Both from day one.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:34px">
            <a href="#demo" style={`display:inline-flex;align-items:center;padding:15px 26px;border-radius:999px;background:${INK};color:${CREAM};font:600 15px 'DM Sans',sans-serif`}>Book a demo</a>
            <a href="#loop" style={`display:inline-flex;align-items:center;padding:15px 26px;border-radius:999px;border:1px solid rgba(20,35,26,.22);color:${INK};font:600 15px 'DM Sans',sans-serif`}>See how it works</a>
          </div>
        </div>
        <div style="display:flex;justify-content:center">
          <div style="position:relative;width:100%;max-width:400px">
            <img src="/assets/norma-world-day.png" alt="" style="width:100%;height:auto;display:block" />
            <img src="/assets/norma-sprout.png" alt="" style="position:absolute;left:50%;top:50%;width:36%;height:auto;transform:translate(-50%,-50%);filter:drop-shadow(0 10px 18px rgba(10,19,13,.22));animation:nrmFloat 6s ease-in-out infinite" />
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · The four pains, dark. Scene 1 of the film: everyday screens, not nørma
         screens. Dark earns its place here because this is the "before". -->
    <section style="background:#0A130D;color:#F4F2E6">
      <div style={`${wrap};padding-top:clamp(56px,7vw,96px);padding-bottom:clamp(56px,7vw,96px)`}>
        <h2 style={`${h2};max-width:16em;color:#F6F4E9`}>Four moments every organisation recognises.</h2>
        <div data-r="pains" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:40px">
          {pains.map((p) => (
            <figure style="margin:0;display:flex;flex-direction:column;gap:14px">
              <div style="position:relative;aspect-ratio:9/13;border-radius:18px;border:1px solid rgba(228,240,214,.12);background:#070D08;overflow:hidden;padding:14px;box-sizing:border-box">
                {p.kind === 'lock' && (
                  <div style="height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px;color:rgba(244,242,230,.85)">
                    <span style="font:400 13px 'DM Mono',monospace;opacity:.6">Tuesday</span>
                    <span style="font:400 38px 'DM Serif Display',serif">11:52</span>
                    <span style="margin-top:12px;width:70%;height:5px;border-radius:3px;background:rgba(244,242,230,.16)"></span>
                    <span style="width:84%;height:5px;border-radius:3px;background:rgba(244,242,230,.1)"></span>
                    <span style="width:60%;height:5px;border-radius:3px;background:rgba(244,242,230,.07)"></span>
                  </div>
                )}
                {p.kind === 'chat' && (
                  <div style="height:100%;display:flex;flex-direction:column;justify-content:flex-end;gap:8px">
                    <span style="align-self:flex-start;max-width:80%;padding:8px 11px;border-radius:14px 14px 14px 4px;background:rgba(228,240,214,.08);font:400 11.5px 'DM Sans',sans-serif;color:rgba(244,242,230,.8)">You good?</span>
                    <span style="align-self:flex-end;max-width:80%;padding:8px 11px;border-radius:14px 14px 4px 14px;background:rgba(217,234,110,.16);font:400 11.5px 'DM Sans',sans-serif;color:#EAF79B">All good 👍</span>
                    <span style="margin-top:6px;padding:7px 10px;border-radius:999px;border:1px solid rgba(228,240,214,.1);font:400 10.5px 'DM Sans',sans-serif;color:rgba(244,242,230,.28);white-space:nowrap;overflow:hidden;text-overflow:clip">Honestly, pretty burnt out|</span>
                  </div>
                )}
                {p.kind === 'meet' && (
                  <div style="height:100%;display:flex;flex-direction:column;gap:6px;justify-content:center">
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:5px">
                      {[0,1,2,3,4,5,6,7,8].map((i) => (
                        <span style={`aspect-ratio:4/3;border-radius:5px;background:rgba(228,240,214,${i === 7 ? '.02' : '.07'})`}></span>
                      ))}
                    </div>
                    <span style="margin-top:8px;font:400 11px 'DM Sans',sans-serif;color:rgba(244,242,230,.45)">Any thoughts?</span>
                  </div>
                )}
                {p.kind === 'mail' && (
                  <div style="height:100%;display:flex;flex-direction:column;gap:9px;justify-content:center">
                    <span style="display:flex;flex-direction:column;gap:4px;padding-bottom:9px;border-bottom:1px solid rgba(228,240,214,.07)">
                      <span style="width:52%;height:5px;border-radius:3px;background:rgba(244,242,230,.1)"></span>
                      <span style="width:76%;height:5px;border-radius:3px;background:rgba(244,242,230,.06)"></span>
                    </span>
                    <span style="display:flex;flex-direction:column;gap:5px">
                      <span style="font:500 12px 'DM Sans',sans-serif;color:#F6F4E9">Resignation</span>
                      <span style="font:400 11px 'DM Sans',sans-serif;color:rgba(244,242,230,.5)">Jordan Lee · 9:04 AM</span>
                    </span>
                  </div>
                )}
              </div>
              <figcaption style="display:flex;flex-direction:column;gap:5px">
                <span style="font:500 10.5px 'DM Mono',monospace;letter-spacing:1.6px;color:rgba(217,234,110,.78)">{p.word}</span>
                <span style="font:400 13.5px/1.45 'DM Sans',sans-serif;color:rgba(201,212,194,.8);text-wrap:pretty">{p.cap}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p style={`margin:40px 0 0;max-width:34em;${lede};color:rgba(201,212,194,.85)`}>
          An annual survey is a photograph of a year ago. An EAP is used by one in twenty. In between,
          nothing tells you which team is sliding, or whether what you did last quarter worked.
        </p>
      </div>
    </section>

    <!-- 3 · The one idea. This is the "why nørma" the client said was missing:
         not another survey, not another EAP. One loop, run on both sides. -->
    <section id="loop" style={`${wrap};padding-top:clamp(64px,8vw,110px);padding-bottom:clamp(56px,7vw,96px)`}>
      <h2 style={`${h2};max-width:14em`}>One loop, run twice.</h2>
      <p style={`margin:20px 0 0;max-width:34em;${lede};color:${MUTED}`}>
        Reflect, understand, act. Your people run it on the five pillars of a whole life, the part only
        they hold. You run it on culture, heard, valued and safe to speak, the part only you hold.
        Shared accountability, built into the product.
      </p>
      <div data-r="loops" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:44px">
        {[
          { who: 'Your people run it on', what: 'their fulfilment', items: ['Health & Fitness', 'Internal Work', 'Love & Relationships', 'Social Connection', 'Work & Life Flow'], note: 'Theirs. Nobody at work can read it.' },
          { who: 'You run it on', what: 'your culture', items: ['Do you feel heard?', 'Do you feel valued?', 'Do you feel safe to speak your truth?'], note: 'Group figures only, never a person.' },
        ].map((c) => (
          <div style={`padding:34px 32px 30px;border-radius:30px 20px 32px 22px / 20px 30px 22px 32px;background:${CREAM_2};border:1px solid rgba(20,35,26,.09)`}>
            <span style={`font:400 15px 'DM Sans',sans-serif;color:${MUTED}`}>{c.who}</span>
            <div style={`margin-top:4px;font:400 30px/1.15 'DM Serif Display',serif;color:${INK}`}>{c.what}</div>
            <ul style="list-style:none;margin:22px 0 0;padding:0;display:flex;flex-direction:column;gap:10px">
              {c.items.map((i) => (
                <li style={`display:flex;align-items:center;gap:11px;font:400 15.5px 'DM Sans',sans-serif;color:${INK}`}>
                  <span style={`flex:none;width:7px;height:7px;border-radius:52% 48% 50% 50% / 50% 54% 46% 50%;background:${LIME}`}></span>
                  {i}
                </li>
              ))}
            </ul>
            <p style={`margin:24px 0 0;padding-top:18px;border-top:1px solid rgba(20,35,26,.1);font:400 14px/1.5 'DM Sans',sans-serif;color:${MUTED}`}>{c.note}</p>
          </div>
        ))}
      </div>
      <p style={`margin:34px 0 0;max-width:30em;font:400 17px/1.55 'DM Sans',sans-serif;color:${INK}`}>
        Always both, from day one. That is the whole product in one sentence.
      </p>
    </section>

    <!-- 4 · The product, employee side. Short on the home page; the depth moves to
         /your-people, shown the way the help centre does it. -->
    <section id="people" style={`background:${CREAM_2}`}>
      <div style={`${wrap};padding-top:clamp(56px,7vw,96px);padding-bottom:clamp(56px,7vw,96px)`}>
        <div data-r="split" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,320px);gap:clamp(32px,5vw,64px);align-items:center">
          <div>
            <h2 style={`${h2};max-width:15em`}>What your people get.</h2>
            <p style={`margin:18px 0 0;max-width:32em;${lede};color:${MUTED}`}>
              A private space that is theirs. They keep using it because it gives them something back,
              which is the only reason the signal you see is real.
            </p>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 26px;margin-top:34px" data-r="feat">
              {appFeatures.map(([t, d]) => (
                <div>
                  <div style={`font:500 16px 'DM Sans',sans-serif;color:${INK}`}>{t}</div>
                  <div style={`margin-top:4px;font:400 14.5px/1.5 'DM Sans',sans-serif;color:${MUTED};text-wrap:pretty`}>{d}</div>
                </div>
              ))}
            </div>
            <div data-r="chaps" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:34px">
              {[['ch-intro-health-b.jpg','Health & Fitness'],['ch-intro-love-b.jpg','Love & Relationships'],['ch-intro-social-b.jpg','Social Connection']].map(([f,label]) => (
                <figure style="margin:0;display:flex;flex-direction:column;gap:8px">
                  <img src={`/assets/journey/${f}`} alt="" loading="lazy" style="width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:16px;display:block" />
                  <figcaption style={`font:400 12px 'DM Sans',sans-serif;color:${MUTED}`}>{label}</figcaption>
                </figure>
              ))}
            </div>
            <p style={`margin:16px 0 0;max-width:30em;font:400 14.5px/1.5 'DM Sans',sans-serif;color:${MUTED}`}>
              Growth Journeys: short illustrated chapters about one pillar, then one thing to try tonight.
            </p>
            <a href="/draft/your-people/" style={`display:inline-block;margin-top:28px;font:600 15px 'DM Sans',sans-serif;color:${INK};border-bottom:2px solid ${LIME};padding-bottom:3px`}>See the whole app ›</a>
          </div>
          <div style="display:flex;justify-content:center">
            <div style="width:290px;flex:none"><Phone screen="home" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Leaders and the promise, together on dark. The film answers the biggest
         objection right after showing the dashboard, so this does too. -->
    <section id="leaders" style="background:#0A130D;color:#F4F2E6">
      <div style={`${wrap};padding-top:clamp(56px,7vw,96px);padding-bottom:clamp(56px,7vw,96px)`}>
        <h2 style={`${h2};max-width:15em;color:#F6F4E9`}>All of it flows into one signal you can act on.</h2>
        <p style={`margin:18px 0 0;max-width:34em;${lede};color:rgba(201,212,194,.85)`}>
          Not a report you read once a year. A monthly picture of how each group is doing, what moved,
          and what to do about it next.
        </p>
        <div data-r="feat2" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 30px;margin-top:36px">
          {leaderFeatures.map(([t, d]) => (
            <div style="padding-top:18px;border-top:1px solid rgba(228,240,214,.1)">
              <div style="font:500 16px 'DM Sans',sans-serif;color:#F6F4E9">{t}</div>
              <div style="margin-top:4px;font:400 14.5px/1.5 'DM Sans',sans-serif;color:rgba(201,212,194,.8);text-wrap:pretty">{d}</div>
            </div>
          ))}
        </div>
        <a href="/draft/for-leaders/" style="display:inline-block;margin-top:32px;font:600 15px 'DM Sans',sans-serif;color:#EAF79B;border-bottom:2px solid rgba(217,234,110,.5);padding-bottom:3px">See the dashboard ›</a>

        <div id="promise" style="margin-top:clamp(48px,6vw,80px);padding:clamp(28px,4vw,44px);border-radius:30px 20px 32px 22px / 20px 30px 22px 32px;background:rgba(228,240,214,.04);border:1px solid rgba(228,240,214,.1)">
          <h3 style="margin:0;font:400 clamp(24px,2.8vw,32px)/1.15 'DM Serif Display',serif;color:#F6F4E9;max-width:18em;text-wrap:pretty">
            Names fall away in flight. Leaders see patterns, never people.
          </h3>
          <p style="margin:16px 0 0;max-width:36em;font:400 16px/1.6 'DM Sans',sans-serif;color:rgba(201,212,194,.86);text-wrap:pretty">
            Individual answers dissolve into a group figure before anything reaches a dashboard. Groups
            below five never appear at all. Nobody where someone works can read their check-in answers,
            their reflections or their recordings. It is a design decision, not a setting.
          </p>
          <p style="margin:14px 0 0;max-width:36em;font:400 14.5px/1.6 'DM Sans',sans-serif;color:rgba(201,212,194,.62);text-wrap:pretty">
            One honest limit we publish rather than hide: the minimum counts the people in a group, not
            the people who answered, so in a small team a figure can come from one person.
          </p>
        </div>
      </div>
    </section>

    <!-- 6 · Close. The film's bookend, which is also the clearest statement of
         what the buyer is actually buying. -->
    <section id="demo" style={`${wrap};padding-top:clamp(64px,8vw,110px);padding-bottom:clamp(72px,9vw,120px);text-align:center`}>
      <img src="/assets/norma-sprout.png" alt="" width="84" height="84" style="margin:0 auto;display:block" />
      <h2 style={`margin:26px 0 0;font:400 clamp(36px,5vw,58px)/1.06 'DM Serif Display',serif;letter-spacing:-1px;text-wrap:balance`}>
        Fulfilled people. Honest culture.
      </h2>
      <p style={`margin:18px auto 0;max-width:26em;${lede};color:${MUTED}`}>
        One system, both sides. Challenging the nørm of employee wellbeing.
      </p>
      <a href="#demo" style={`display:inline-flex;align-items:center;margin-top:30px;padding:16px 30px;border-radius:999px;background:${INK};color:${CREAM};font:600 16px 'DM Sans',sans-serif`}>Book a demo</a>
      <p style={`margin:22px 0 0;font:400 13.5px 'DM Sans',sans-serif;color:${MUTED}`}>
        Minimum group of five · a mirror that never advises · built in Australia
      </p>
    </section>

    <div style={`border-top:1px solid rgba(20,35,26,.1)`}>
      <div style={`${wrap};padding-top:28px;padding-bottom:40px;display:flex;flex-wrap:wrap;gap:10px 28px;justify-content:space-between;font:400 12.5px 'DM Sans',sans-serif;color:${MUTED}`}>
        <span>© 2026 The Artistry of Humanity Pty Ltd</span>
        <span style="display:flex;gap:20px">
          <a href="/privacy/" style={`color:${MUTED}`}>Privacy policy</a>
          <a href="/terms/" style={`color:${MUTED}`}>Terms of use</a>
          <a href="/help/" style={`color:${MUTED}`}>Help centre</a>
        </span>
      </div>
    </div>
  </div>

  <style is:global>
    @media (max-width:900px){
      [data-r=dnav]{display:none!important}
      [data-r=herogrid]{grid-template-columns:minmax(0,1fr)!important}
      [data-r=split]{grid-template-columns:minmax(0,1fr)!important}
      [data-r=pains]{grid-template-columns:repeat(2,minmax(0,1fr))!important}
    }
    /* Chapter art is the warmest thing on the page, so on a phone it scrolls
       sideways at a readable size instead of shrinking to three thumbnails. */
    @media (max-width:760px){
      [data-r=chaps]{display:flex!important;overflow-x:auto;scroll-snap-type:x mandatory;margin-left:-20px;margin-right:-20px;padding:0 20px;gap:12px}
      [data-r=chaps] figure{flex:0 0 58%;scroll-snap-align:start}
    }
    @media (max-width:620px){
      [data-r=loops]{grid-template-columns:minmax(0,1fr)!important}
      [data-r=feat],[data-r=feat2]{grid-template-columns:minmax(0,1fr)!important}
    }
  </style>
</Layout>
