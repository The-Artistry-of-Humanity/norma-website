  <script is:inline>
    // Moments carousel: click through, and it drifts on by itself. Pauses on
    // hover, focus or touch and when off screen; still for reduced motion.
    (function () {
      var t = document.getElementById('mtrack'); if (!t) return;
      var slides = t.querySelectorAll('[data-slide]'), n = slides.length;
      var prev = document.getElementById('mprev'), next = document.getElementById('mnext'), count = document.getElementById('mcount');
      function step() { return slides[0].getBoundingClientRect().width + 14; }
      function idx() { return Math.round(t.scrollLeft / step()); }
      function perView() { return Math.max(1, Math.round(t.clientWidth / step())); }
      function last() { return Math.max(0, n - perView()); }
      function go(i) { t.scrollTo({ left: Math.max(0, Math.min(i, last())) * step(), behavior: 'smooth' }); }
      function label() { var i = idx(); count.textContent = (i + 1) + ' of ' + n; }
      prev.addEventListener('click', function () { go(idx() - 1); });
      next.addEventListener('click', function () { go(idx() >= last() ? 0 : idx() + 1); });
      t.addEventListener('scroll', function () { window.requestAnimationFrame(label); }, { passive: true });
      label();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var paused = false, visible = false;
      ['mouseenter', 'focusin', 'touchstart', 'pointerdown'].forEach(function (e) { t.addEventListener(e, function () { paused = true; }, { passive: true }); });
      ['mouseleave', 'focusout'].forEach(function (e) { t.addEventListener(e, function () { paused = false; }); });
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }, { threshold: 0.4 }).observe(t);
      setInterval(function () { if (!paused && visible) go(idx() >= last() ? 0 : idx() + 1); }, 4500);
    })();
  </script>

  <style is:global>
    [data-r=mtrack]::-webkit-scrollbar{display:none}
    @media (max-width:1100px){
