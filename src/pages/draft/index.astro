      [data-r=split],[data-r=split2]{grid-template-columns:minmax(0,1fr)!important}
      [data-r=mtrack] [data-slide]{flex-basis:calc((100% - 14px) / 2)!important}
      [data-r=dash3]{grid-template-columns:minmax(0,1fr)!important}
    }
    @media (max-width:760px){
