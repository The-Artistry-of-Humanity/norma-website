---
/* DRAFT home page v3, 14 Oct 2026. Not linked from anywhere, noindex.
   Story: nobody leaves their life at the door. Somewhere in your organisation
   it is costing you (absenteeism, presenteeism, turnover). Right now you are
   running in the dark. nørma turns the lights on: see it, act on it, see if it
   moved. The problem has two sides, so does nørma: their life comes to work
   with them (five pillars, and nørma the character goes with them), and the
   culture they walk into is yours to shape (the nørma Score). Fulfilled people.
   Honest culture.
   Palette: cream is the base, dark is punctuation. Dark for the cost of not
   knowing, a lime flashlight searching it, then light.
   Cost figures are the live ROI calculator's published defaults (AHRI Work
   Outlook 2025–26, ABS, APSC) applied to 1,000 people. Session steps are the
   playbook rituals from the app's own content. Nothing here touches live pages. */
import Layout from '../../layouts/Layout.astro';
import Phone from '../../islands/Phone';
import Dash from '../../components/draft/Dash.astro';
import { PILLAR_HEADS, CULTURE_HEADS } from '../../islands/v3/home-logic.js';

const INK = '#14231A';
const MUTED = 'rgba(20,35,26,.7)';
const CREAM = '#F4F2E6';
const CREAM_2 = '#ECE8D7';

const wrap = 'max-width:1120px;margin:0 auto;padding-left:40px;padding-right:40px;box-sizing:border-box';
const h2 = `margin:0;font:400 clamp(32px,3.8vw,46px)/1.08 'DM Serif Display',serif;letter-spacing:-.6px;text-wrap:balance`;
const lede = `font:400 18px/1.6 'DM Sans',sans-serif;text-wrap:pretty`;
// The brand's primary button, kept from the live site: lime with its glow.
// On cream it gets a hairline edge so it still reads as a button.
const LIME_BTN = `display:inline-flex;align-items:center;padding:15px 26px;border-radius:999px;background:linear-gradient(180deg,#E9F693,#D3E45F);color:#152213;font:600 15px 'DM Sans',sans-serif;box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 0 0 1px rgba(20,35,26,.10),0 12px 32px rgba(190,210,60,.38)`;
const GHOST_BTN = `display:inline-flex;align-items:center;padding:15px 26px;border-radius:999px;border:1px solid rgba(20,35,26,.22);color:${INK};font:600 15px 'DM Sans',sans-serif`;

// One icon per cost, used on the moments, the legend and the totals so the
// three are recognised at a glance instead of read as labels.
const ICON: Record<string, string[]> = {
  Absenteeism: ['M4 6.5h16v13H4z', 'M8 4v5M16 4v5M4 10.5h16', 'M10 13.5l4 4M14 13.5l-4 4'],
  Presenteeism: ['M5 8h12.5a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 1-1.5 1.5H5a1.5 1.5 0 0 1-1.5-1.5v-5A1.5 1.5 0 0 1 5 8z', 'M21 11v2', 'M6.5 10.5v3'],
  Turnover: ['M13 4H6v16h7', 'M10 12h10', 'M17 9l3 3-3 3'],
};
const COSTS = ['Absenteeism', 'Presenteeism', 'Turnover'];

// Mixed so no cost repeats back to back.
const moments = [
  { cost: 'Absenteeism', kind: 'sick', cap: 'The 7 am text.', line: 'One unplanned day costs about $520.' },
  { cost: 'Presenteeism', kind: 'chat', cap: 'The "all good" that isn’t.', line: 'At work, not really there.' },
  { cost: 'Turnover', kind: 'mail', cap: 'The resignation nobody saw coming.', line: 'Replacing one person: about half a year’s salary.' },
  { cost: 'Absenteeism', kind: 'mondays', cap: 'The third Monday this month.', line: 'Nine days a person a year, on average.' },
  { cost: 'Presenteeism', kind: 'meet', cap: 'The meeting where nobody says what they think.', line: 'The idea nobody raises.' },
  { cost: 'Turnover', kind: 'exit', cap: 'The exit interview.', line: 'You only hear it on the way out.' },
];

// 1,000 people on the calculator's all-industry defaults.
const totals = [
  { k: 'Absenteeism', v: '$4.7 million', d: '9,000 unplanned days off.' },
  { k: 'Presenteeism', v: '$10.8 million', d: 'At work, not really there. The biggest cost, and the one you can’t see.' },
  { k: 'Turnover', v: '$6.8 million', d: '135 people leave, each costing about half a year’s salary to replace.' },
];

const PILLAR_LINES = [
  'How they care for their body and energy.',
  'Their inner life: mind, attention and self.',
  'Closeness, romance and feeling at peace.',
  'Friends, community and belonging.',
  'How work sits within the rest of their life.',
];
const PILLAR_NAMES = ['Health & Fitness', 'Internal Work', 'Love & Relationships', 'Social Connection', 'Work & Life Flow'];

// Band tints, the site's own legend.
const band = (v: number) => v >= 70 ? ['rgba(217,234,110,.42)', '#F2FBB8'] : v >= 55 ? ['rgba(228,240,214,.12)', '#F4F2E6'] : v >= 46 ? ['rgba(230,199,126,.4)', '#F8E9C9'] : ['rgba(231,142,113,.48)', '#FBDFD0'];
const ROWS: [string, number][] = [['Field Services', 44], ['Sales', 52], ['Customer Success', 56], ['Engineering', 60]];
// Field Services culture, the month after the session. A modest, honest rise.
const MOVE = [['AUG', 47], ['SEP', 46], ['OCT', 43], ['NOV', 47]] as [string, number][];
const mx = (i: number) => 14 + i * 64, my = (v: number) => 88 - (v - 38) * 5.2;
const card = 'border-radius:22px;background:linear-gradient(165deg,#0F2015,#17301F);color:#F4F2E6;box-sizing:border-box';
---
<Layout title="nørma · draft home v3" description="Draft home page for review. Not public." noindex>
  <div style={`background:${CREAM};color:${INK};font-family:'DM Sans',sans-serif;overflow-x:clip`}>

    <div style="position:sticky;top:0;z-index:50;background:rgba(244,242,230,.86);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid rgba(20,35,26,.08)">
      <div style={`${wrap};height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px`}>
        <span style="display:flex;align-items:center;gap:10px">
          <img src="/assets/norma-logo.png" alt="" width="30" height="30" style="border-radius:9px" />
          <span style={`font:400 23px 'DM Serif Display',serif;color:${INK}`}>nørma</span>
        </span>
        <span style="display:flex;align-items:center;gap:26px">
          <span data-r="dnav" style={`display:flex;gap:26px;font:500 14px 'DM Sans',sans-serif`}>
            <a href="/your-people/" style={`color:${MUTED}`}>Your people</a>
            <a href="/for-leaders/" style={`color:${MUTED}`}>For leaders</a>
            <a href="/roi/" style={`color:${MUTED}`}>ROI</a>
            <a href="/help/" style={`color:${MUTED}`}>Help</a>
          </span>
          <a href="/book-a-demo/" style={`${LIME_BTN};padding:11px 20px;font-size:13.5px`}>Book a demo</a>
        </span>
      </div>
    </div>

    <!-- 1 · Hero. One line, then what nørma is, then the product itself. -->
    <section style={`${wrap};padding-top:clamp(56px,8vw,104px);padding-bottom:clamp(56px,7vw,96px)`}>
      <div data-r="herogrid" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,560px);gap:clamp(32px,4vw,56px);align-items:center">
        <div>
          <h1 style={`margin:0;max-width:10em;font:400 clamp(44px,4.9vw,68px)/1.02 'DM Serif Display',serif;letter-spacing:-1.2px;text-wrap:balance`}>
            Nobody leaves their life at the door.
          </h1>
          <p style={`margin:26px 0 0;max-width:30em;font:400 19px/1.55 'DM Sans',sans-serif;color:${MUTED};text-wrap:pretty`}>
            nørma is an app for your people and a dashboard for you. They see where their life is at.
            You see where your culture is at, and what to do about it.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
            <a href="/book-a-demo/" style={LIME_BTN}>Book a demo</a>
            <a href="#dark" style={GHOST_BTN}>See why it matters</a>
          </div>
        </div>
        <div data-r="herovis" style="position:relative;width:560px;height:440px;justify-self:center">
          <div data-r="herovisin" style="position:absolute;left:0;top:0;width:560px;height:440px;transform-origin:top left">
            <div style="position:absolute;left:0;top:0;width:470px;padding:18px;border-radius:30px 20px 32px 22px / 20px 30px 22px 32px;background:linear-gradient(165deg,#0F2015,#17301F);box-shadow:0 40px 80px rgba(20,35,26,.28);box-sizing:border-box">
              <div style="display:flex;align-items:center;justify-content:space-between;margin:2px 4px 14px">
                <span style="font:400 21px 'DM Serif Display',serif;color:#F6F4E9">Northwind</span>
                <span style="font:500 11px 'DM Mono',monospace;color:#DCEC85">October signal</span>
              </div>
              <Dash variant="hero" />
            </div>
            <div style="position:absolute;right:0;top:118px;width:290px;transform:scale(.66);transform-origin:top right;filter:drop-shadow(0 30px 50px rgba(10,19,13,.35))"><Phone screen="home" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · What it costs. Second person, mixed moments that roll on without
         snapping back, one icon per cost. -->
    <section id="dark" style="background:#0A130D;color:#F4F2E6">
      <div style={`${wrap};padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,96px)`}>
        <h2 style={`${h2};max-width:15em;color:#F6F4E9`}>Somewhere in your organisation, this is happening today.</h2>
        <div style="display:flex;flex-wrap:wrap;gap:10px 26px;margin-top:22px">
          {COSTS.map((k) => (
            <span style="display:inline-flex;align-items:center;gap:10px;font:500 14px 'DM Sans',sans-serif;color:rgba(244,242,230,.86)">
              <span style="width:32px;height:32px;border-radius:52% 48% 50% 50% / 50% 54% 46% 50%;background:rgba(217,234,110,.14);display:flex;align-items:center;justify-content:center;color:#EAF79B">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{ICON[k].map((d) => <path d={d} />)}</svg>
              </span>{k}
            </span>
          ))}
        </div>

        <div style="position:relative;margin-top:36px">
          <div id="mtrack" data-r="mtrack" tabindex="0" aria-label="Moments, scroll sideways" style="display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:4px;scrollbar-width:none">
            {[0, 1].map((copy) => moments.map((m) => (
              <figure data-slide data-clone={copy ? '' : undefined} aria-hidden={copy ? 'true' : undefined} style="flex:0 0 calc((100% - 28px) / 3);scroll-snap-align:start;margin:0;display:flex;flex-direction:column;gap:14px">
                <div style="position:relative;height:300px;border-radius:20px;border:1px solid rgba(228,240,214,.11);background:#070D08;overflow:hidden;padding:18px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center">
                  <span title={m.cost} style="position:absolute;left:14px;top:14px;width:32px;height:32px;border-radius:52% 48% 50% 50% / 50% 54% 46% 50%;background:rgba(217,234,110,.14);display:flex;align-items:center;justify-content:center;color:#EAF79B">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={m.cost}>{ICON[m.cost].map((d) => <path d={d} />)}</svg>
                  </span>
                  {m.kind === 'sick' && (
                    <div style="display:flex;flex-direction:column;gap:10px">
                      <span style="align-self:center;font:400 12px 'DM Mono',monospace;color:rgba(244,242,230,.5)">7:12 am</span>
                      <div style="padding:12px 14px;border-radius:16px;background:rgba(228,240,214,.07)">
                        <div style="font:600 12px 'DM Sans',sans-serif;color:#F6F4E9">Sam</div>
                        <div style="margin-top:4px;font:400 13px/1.45 'DM Sans',sans-serif;color:rgba(244,242,230,.82)">Morning. Not feeling great, won’t make it in today. Sorry 🤒</div>
                      </div>
                    </div>
                  )}
                  {m.kind === 'mondays' && (
                    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:5px">
                      {['M','T','W','T','F'].map((d) => <span style="text-align:center;font:500 10px 'DM Mono',monospace;color:rgba(244,242,230,.4)">{d}</span>)}
                      {Array.from({ length: 20 }).map((_, i) => (
                        <span style={`height:30px;border-radius:6px;background:${i % 5 === 0 && i < 15 ? 'rgba(231,142,113,.32)' : 'rgba(228,240,214,.05)'};display:flex;align-items:center;justify-content:center;font:500 9.5px 'DM Sans',sans-serif;color:#FBDFD0`}>{i % 5 === 0 && i < 15 ? 'Sick' : ''}</span>
                      ))}
                    </div>
                  )}
                  {m.kind === 'chat' && (
                    <div style="display:flex;flex-direction:column;gap:9px">
                      <span style="align-self:flex-start;padding:9px 13px;border-radius:16px 16px 16px 5px;background:rgba(228,240,214,.08);font:400 13px 'DM Sans',sans-serif;color:rgba(244,242,230,.85)">You good?</span>
                      <span style="align-self:flex-end;padding:9px 13px;border-radius:16px 16px 5px 16px;background:rgba(217,234,110,.16);font:400 13px 'DM Sans',sans-serif;color:#EAF79B">All good 👍</span>
                      <span style="margin-top:8px;padding:8px 12px;border-radius:999px;border:1px solid rgba(228,240,214,.1);font:400 12px 'DM Sans',sans-serif;color:rgba(244,242,230,.3);text-decoration:line-through;text-decoration-color:rgba(244,242,230,.25)">Honestly, I’m pretty burnt out</span>
                    </div>
                  )}
                  {m.kind === 'meet' && (
                    <div>
                      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px">
                        {Array.from({ length: 9 }).map((_, i) => (
                          <span style={`aspect-ratio:4/3;border-radius:6px;background:rgba(228,240,214,${i === 4 ? '.02' : '.07'});position:relative`}><span style="position:absolute;right:5px;bottom:5px;width:6px;height:6px;border-radius:50%;background:rgba(231,142,113,.7)"></span></span>
                        ))}
                      </div>
                      <div style="margin-top:12px;padding:9px 12px;border-radius:12px;background:rgba(228,240,214,.05);font:400 12.5px 'DM Sans',sans-serif;color:rgba(244,242,230,.6)">“Any thoughts?” <span style="color:rgba(244,242,230,.32)">· no replies</span></div>
                    </div>
                  )}
                  {m.kind === 'mail' && (
                    <div style="display:flex;flex-direction:column;gap:12px">
                      {[0, 1].map(() => <span style="display:block;height:8px;width:70%;border-radius:4px;background:rgba(244,242,230,.07)"></span>)}
                      <div style="padding:12px 14px;border-radius:14px;background:rgba(228,240,214,.06);border-left:3px solid #E78E71">
                        <div style="font:600 13.5px 'DM Sans',sans-serif;color:#F6F4E9">Resignation</div>
                        <div style="margin-top:3px;font:400 12px 'DM Sans',sans-serif;color:rgba(244,242,230,.55)">Jordan Lee · 9:04 am</div>
                      </div>
                      {[0, 1].map(() => <span style="display:block;height:8px;width:56%;border-radius:4px;background:rgba(244,242,230,.05)"></span>)}
                    </div>
                  )}
                  {m.kind === 'exit' && (
                    <div style="display:flex;flex-direction:column;gap:10px">
                      <span style="font:500 10.5px 'DM Mono',monospace;letter-spacing:1.2px;color:rgba(244,242,230,.45)">EXIT INTERVIEW · NOTES</span>
                      <div style="font:400 20px/1.3 'DM Serif Display',serif;color:#F6F4E9">“It wasn’t one thing. It just built up.”</div>
                      <span style="font:400 12px 'DM Sans',sans-serif;color:rgba(244,242,230,.45)">Two years, eleven months</span>
                    </div>
                  )}
                </div>
                <figcaption style="display:flex;flex-direction:column;gap:5px">
                  <span style="font:400 18px/1.3 'DM Serif Display',serif;color:#F6F4E9;text-wrap:pretty">{m.cap}</span>
                  <span style="font:400 14px/1.45 'DM Sans',sans-serif;color:rgba(201,212,194,.8);text-wrap:pretty">{m.line}</span>
                </figcaption>
              </figure>
            )))}
          </div>
          <div style="display:flex;align-items:center;gap:10px;margin-top:22px">
            <button id="mprev" type="button" aria-label="Previous moment" style="width:44px;height:44px;border-radius:999px;border:1px solid rgba(228,240,214,.18);background:transparent;color:#F4F2E6;font:400 18px 'DM Sans',sans-serif;cursor:pointer">‹</button>
            <button id="mnext" type="button" aria-label="Next moment" style="width:44px;height:44px;border-radius:999px;border:1px solid rgba(228,240,214,.18);background:transparent;color:#F4F2E6;font:400 18px 'DM Sans',sans-serif;cursor:pointer">›</button>
          </div>
        </div>

        <h3 style="margin:clamp(56px,7vw,88px) 0 0;max-width:20em;font:400 clamp(26px,3vw,36px)/1.15 'DM Serif Display',serif;color:#F6F4E9;text-wrap:balance">
          For an organisation of 1,000 people, that adds up to about <span style="color:#EAF79B">$22 million a year.</span>
        </h3>
        <div data-r="costs" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:28px">
          {totals.map((c) => (
            <div style="padding:22px 22px 20px;border-radius:22px 16px 24px 14px / 16px 24px 14px 22px;background:rgba(228,240,214,.045);border:1px solid rgba(228,240,214,.09)">
              <div style="display:flex;align-items:center;gap:10px;font:500 14px 'DM Sans',sans-serif;color:rgba(244,242,230,.86)">
                <span style="width:32px;height:32px;border-radius:52% 48% 50% 50% / 50% 54% 46% 50%;background:rgba(217,234,110,.14);display:flex;align-items:center;justify-content:center;color:#EAF79B">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{ICON[c.k].map((d) => <path d={d} />)}</svg>
                </span>{c.k}
              </div>
              <div style="margin-top:16px;font:400 34px/1 'DM Serif Display',serif;color:#F6F4E9">{c.v}</div>
              <p style="margin:12px 0 0;font:400 14.5px/1.5 'DM Sans',sans-serif;color:rgba(244,242,230,.8);text-wrap:pretty">{c.d}</p>
            </div>
          ))}
        </div>
        <p style="margin:16px 0 0;font:400 12px/1.5 'DM Sans',sans-serif;color:rgba(201,212,194,.55)">All-industry benchmarks for 1,000 people on an average $100,000 salary: AHRI Work Outlook 2025–26, ABS, APSC.</p>
      </div>
    </section>

    <!-- 3 · Running in the dark. A lime flashlight searches the dark: it drifts on
         its own and follows the pointer on a desktop. Still for reduced motion. -->
    <section id="search" data-r="search" style="position:relative;overflow:hidden;background:#060B07;color:#F4F2E6">
      <div id="beam" aria-hidden="true" style="position:absolute;left:30%;top:45%;width:min(720px,120vw);aspect-ratio:1;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(217,234,110,.17),rgba(217,234,110,.06) 45%,rgba(217,234,110,0) 72%);pointer-events:none;animation:nrmSearch 18s ease-in-out infinite alternate"></div>
      <div style={`${wrap};position:relative;min-height:clamp(420px,62vh,620px);display:flex;flex-direction:column;justify-content:center;padding-top:96px;padding-bottom:96px`}>
        <h2 style={`${h2};max-width:12em;font-size:clamp(38px,5vw,64px);color:#F6F4E9`}>Right now, you’re running in the dark.</h2>
        <p style={`margin:22px 0 0;max-width:32em;${lede};color:rgba(201,212,194,.82)`}>
          An annual survey is a photograph of a year ago. An EAP is used by one in twenty. In between,
          nothing tells you which team is sliding, so you find out at the resignation.
        </p>
      </div>
    </section>

    <!-- 4 · The lights come on. Three steps, each shown, not just said. -->
    <section style={`${wrap};padding-top:clamp(72px,9vw,112px);padding-bottom:clamp(56px,7vw,88px)`}>
      <h2 style={`${h2};max-width:14em;font-size:clamp(38px,5vw,60px)`}>nørma turns the lights on.</h2>
      <p style={`margin:18px 0 0;max-width:34em;${lede};color:${MUTED}`}>Every month, for every team.</p>
      <ol data-r="steps" style="list-style:none;margin:44px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px">
        <li style="display:flex;flex-direction:column;gap:16px">
          <div style={`${card};height:236px;padding:16px 16px 14px;display:flex;flex-direction:column;gap:7px`} aria-hidden="true">
            <div style="display:flex;justify-content:space-between;font:600 10px 'DM Sans',sans-serif;letter-spacing:1.6px;color:rgba(201,212,194,.7)"><span>BY DEPARTMENT</span><span>FULFILMENT</span></div>
            {ROWS.map(([n, v], i) => (
              <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:5px 2px;border-top:1px solid rgba(228,240,214,.06)">
                <span style="display:flex;align-items:center;gap:8px;font:400 14px 'DM Serif Display',serif;color:#F6F4E9">{i === 0 && <span style="width:7px;height:7px;border-radius:50%;background:#E78E71"></span>}{n}</span>
                <span style={`min-width:44px;text-align:center;padding:4px 0;border-radius:9px;background:${band(v)[0]};color:${band(v)[1]};font:400 15px 'DM Serif Display',serif`}>{v}</span>
              </div>
            ))}
          </div>
          <div>
            <span style={`font:500 12px 'DM Mono',monospace;color:${MUTED}`}>01</span>
            <div style={`margin-top:6px;font:400 24px/1.2 'DM Serif Display',serif;color:${INK}`}>See what’s going on</div>
            <p style={`margin:6px 0 0;font:400 15.5px/1.5 'DM Sans',sans-serif;color:${MUTED}`}>Every team, as group figures. Never a person’s answers.</p>
          </div>
        </li>
        <li style="display:flex;flex-direction:column;gap:16px">
          <div style={`${card};height:236px;padding:16px;display:flex;flex-direction:column;gap:10px`} aria-hidden="true">
            <div style="display:flex;align-items:center;gap:8px;font:600 10px 'DM Sans',sans-serif;letter-spacing:1.6px;color:rgba(201,212,194,.7)"><span style="width:7px;height:7px;border-radius:50%;background:#E78E71"></span>FOCUS AREA</div>
            <div style="font:400 19px 'DM Serif Display',serif;color:#F6F4E9">Field Services</div>
            <div style="font:400 13px/1.4 'DM Sans',sans-serif;color:rgba(244,242,230,.78)">Feeling safe is the lowest answer in the company.</div>
