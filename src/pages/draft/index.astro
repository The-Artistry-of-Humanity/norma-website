  <script is:inline>
    // Moments: the set is rendered twice, so the carousel can keep rolling
    // forward and quietly reset into the first copy, never snapping back to
    // the start. Drifts on its own; pauses on hover, focus, touch and when off
    // screen; no auto-drift for reduced motion.
    (function () {
      var t = document.getElementById('mtrack'); if (!t) return;
      var all = t.querySelectorAll('[data-slide]'), n = all.length / 2;
      t.querySelectorAll('[data-clone] a, [data-clone] button').forEach(function (e) { e.tabIndex = -1; });
      function step() { return all[0].getBoundingClientRect().width + 14; }
      function idx() { return Math.round(t.scrollLeft / step()); }
      function jump(x) { var s = t.style.scrollSnapType; t.style.scrollSnapType = 'none'; t.scrollLeft = x; t.offsetHeight; t.style.scrollSnapType = s; }
      function normalise() { var i = idx(); if (i >= n) jump(t.scrollLeft - n * step()); }
      function go(i) { t.scrollTo({ left: i * step(), behavior: 'smooth' }); }
      var settle; t.addEventListener('scroll', function () { clearTimeout(settle); settle = setTimeout(normalise, 160); }, { passive: true });
      var lastManual = 0;
      document.getElementById('mnext').addEventListener('click', function () { lastManual = Date.now(); go(idx() + 1); });
      document.getElementById('mprev').addEventListener('click', function () { lastManual = Date.now(); var i = idx(); if (i === 0) { jump(n * step()); i = n; } go(i - 1); });
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var paused = false, visible = false;
      ['mouseenter', 'focusin', 'touchstart', 'pointerdown'].forEach(function (e) { t.addEventListener(e, function () { paused = true; }, { passive: true }); });
      ['mouseleave', 'focusout'].forEach(function (e) { t.addEventListener(e, function () { paused = false; }); });
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }, { threshold: 0.4 }).observe(t);
      setInterval(function () { if (!paused && visible && Date.now() - lastManual > 4500) go(idx() + 1); }, 4500);
    })();
    // Flashlight: drifts by itself; on a desktop it follows the pointer.
    (function () {
      var s = document.getElementById('search'), b = document.getElementById('beam'); if (!s || !b) return;
      if (!window.matchMedia('(pointer: fine)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      s.addEventListener('mousemove', function (e) {
        var r = s.getBoundingClientRect();
        b.style.animation = 'none'; b.style.transition = 'left .5s ease, top .5s ease';
        b.style.left = (e.clientX - r.left) + 'px'; b.style.top = (e.clientY - r.top) + 'px';
      });
      s.addEventListener('mouseleave', function () { b.style.transition = ''; b.style.left = ''; b.style.top = ''; b.style.animation = ''; });
    })();
  </script>

  <style is:global>
    @keyframes nrmSearch{0%{left:22%;top:40%}25%{left:62%;top:62%}50%{left:40%;top:28%}75%{left:78%;top:46%}100%{left:30%;top:66%}}
    @media (prefers-reduced-motion: reduce){#beam{animation:none!important;left:28%!important;top:45%!important}}
    [data-r=mtrack]::-webkit-scrollbar{display:none}
    @media (max-width:1100px){
      [data-r=herogrid]{grid-template-columns:minmax(0,1fr)!important}
      [data-r=herovis]{justify-self:start!important}
    }
    @media (max-width:900px){
