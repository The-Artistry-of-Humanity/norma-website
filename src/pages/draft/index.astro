---
/* DRAFT home page v2, 14 Oct 2026. Not linked from anywhere, noindex.
   Story, from Hendryk's notes on v1: you are running in the dark, and it costs
   you (absenteeism, presenteeism, turnover). nørma turns the lights on: see it,
   act on it, see if it moved. Two sides because the problem has two sides:
   their life comes to work with them (the five pillars, a companion that shows
   them where they are), and the culture they walk into is yours to shape (the
   nørma Score). Fulfilled people. Honest culture.
   Palette: cream is the base, dark is punctuation. The page goes dark for the
   cost of not knowing and turns light at "nørma turns the lights on".
   Cost figures are the live ROI calculator's published defaults (AHRI Work
   Outlook 2025–26, ABS, APSC), never new numbers. Nothing here touches live pages. */
import Layout from '../../layouts/Layout.astro';
import Phone from '../../islands/Phone';
import Dash from '../../components/draft/Dash.astro';
import { PILLAR_HEADS, CULTURE_HEADS } from '../../islands/v3/home-logic.js';

const INK = '#14231A';
const MUTED = 'rgba(20,35,26,.7)';
const CREAM = '#F4F2E6';
const CREAM_2 = '#ECE8D7';

const wrap = 'max-width:1120px;margin:0 auto;padding-left:40px;padding-right:40px;box-sizing:border-box';
const h2 = `margin:0;font:400 clamp(32px,3.8vw,46px)/1.08 'DM Serif Display',serif;letter-spacing:-.6px;text-wrap:balance`;
const lede = `font:400 18px/1.6 'DM Sans',sans-serif;text-wrap:pretty`;
// The brand's primary button, kept from the live site: lime with its glow.
// On cream it gets a hairline edge so it still reads as a button.
const LIME_BTN = `display:inline-flex;align-items:center;padding:15px 26px;border-radius:999px;background:linear-gradient(180deg,#E9F693,#D3E45F);color:#152213;font:600 15px 'DM Sans',sans-serif;box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 0 0 1px rgba(20,35,26,.10),0 12px 32px rgba(190,210,60,.38)`;
const GHOST_BTN = `display:inline-flex;align-items:center;padding:15px 26px;border-radius:999px;border:1px solid rgba(20,35,26,.22);color:${INK};font:600 15px 'DM Sans',sans-serif`;

// Moments, in second person, two per cost. Absenteeism, then presenteeism
// (the biggest and the one nobody sees), then turnover.
const moments = [
  { cost: 'Absenteeism', kind: 'sick', cap: 'The 7 am text.', line: 'One unplanned day costs about A$520.' },
  { cost: 'Absenteeism', kind: 'mondays', cap: 'The third Monday this month.', line: 'Nine days a person a year, on average.' },
  { cost: 'Presenteeism', kind: 'chat', cap: 'The "all good" that isn’t.', line: 'At work, not really there.' },
  { cost: 'Presenteeism', kind: 'meet', cap: 'The meeting where nobody says what they think.', line: 'The idea nobody raises.' },
  { cost: 'Turnover', kind: 'mail', cap: 'The resignation nobody saw coming.', line: 'Replacing one person: about half a year’s salary.' },
  { cost: 'Turnover', kind: 'exit', cap: 'The exit interview.', line: '"It wasn’t one thing. It just built up."' },
];

const costs = [
  { k: 'Absenteeism', v: 'A$4,700', d: 'Unplanned days off, nine a person a year.' },
  { k: 'Presenteeism', v: 'A$10,800', d: 'At work, not really there. The biggest, and the one you can’t see.' },
  { k: 'Turnover', v: 'A$6,750', d: 'People who leave, at about half a year’s salary each to replace.' },
];

const PILLAR_LINES = [
  'How they care for their body and energy.',
  'Their inner life: mind, attention and self.',
  'Closeness, romance and feeling at peace.',
  'Friends, community and belonging.',
  'How work sits within the rest of their life.',
];
const PILLAR_NAMES = ['Health & Fitness', 'Internal Work', 'Love & Relationships', 'Social Connection', 'Work & Life Flow'];
---
<Layout title="nørma · draft home v2" description="Draft home page for review. Not public." noindex>
  <div style={`background:${CREAM};color:${INK};font-family:'DM Sans',sans-serif;overflow-x:clip`}>

    <div style="position:sticky;top:0;z-index:50;background:rgba(244,242,230,.86);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid rgba(20,35,26,.08)">
      <div style={`${wrap};height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px`}>
        <span style="display:flex;align-items:center;gap:10px">
          <img src="/assets/norma-logo.png" alt="" width="30" height="30" style="border-radius:9px" />
          <span style={`font:400 23px 'DM Serif Display',serif;color:${INK}`}>nørma</span>
        </span>
        <span style="display:flex;align-items:center;gap:26px">
          <span data-r="dnav" style={`display:flex;gap:26px;font:500 14px 'DM Sans',sans-serif`}>
            <a href="#people" style={`color:${MUTED}`}>Your people</a>
            <a href="#leaders" style={`color:${MUTED}`}>For leaders</a>
            <a href="/#roi" style={`color:${MUTED}`}>ROI</a>
            <a href="/help/" style={`color:${MUTED}`}>Help</a>
          </span>
          <a href="#demo" style={`${LIME_BTN};padding:11px 20px;font-size:13.5px`}>Book a demo</a>
        </span>
      </div>
    </div>

    <!-- 1 · Hero. The hook, then in plain words what nørma is, then the product
         itself, so a visitor knows in one glance this is software. -->
    <section style={`${wrap};padding-top:clamp(56px,8vw,104px);padding-bottom:clamp(56px,7vw,96px)`}>
      <div data-r="herogrid" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,560px);gap:clamp(32px,4vw,56px);align-items:center">
        <div>
          <h1 style={`margin:0;font:400 clamp(40px,5.2vw,64px)/1.03 'DM Serif Display',serif;letter-spacing:-1.1px;text-wrap:balance`}>
            Nobody leaves their life at the door. Nobody tells the truth at work.
          </h1>
          <p style={`margin:24px 0 0;max-width:30em;font:400 19px/1.55 'DM Sans',sans-serif;color:${MUTED};text-wrap:pretty`}>
            nørma is an app for your people and a dashboard for you. They see where their life is at.
            You see where your culture is at, and what to do about it.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
            <a href="#demo" style={LIME_BTN}>Book a demo</a>
            <a href="#dark" style={GHOST_BTN}>See why it matters</a>
          </div>
        </div>
        <div data-r="herovis" style="position:relative;width:560px;height:440px;justify-self:center">
          <div data-r="herovisin" style="position:absolute;left:0;top:0;width:560px;height:440px;transform-origin:top left">
            <div style="position:absolute;left:0;top:0;width:470px;padding:18px;border-radius:30px 20px 32px 22px / 20px 30px 22px 32px;background:linear-gradient(165deg,#0F2015,#17301F);box-shadow:0 40px 80px rgba(20,35,26,.28);box-sizing:border-box">
              <div style="display:flex;align-items:center;justify-content:space-between;margin:2px 4px 14px">
                <span style="font:400 21px 'DM Serif Display',serif;color:#F6F4E9">Northwind</span>
                <span style="font:500 11px 'DM Mono',monospace;color:#DCEC85">October signal</span>
              </div>
              <Dash variant="hero" />
            </div>
            <div style="position:absolute;right:0;top:118px;width:290px;transform:scale(.66);transform-origin:top right;filter:drop-shadow(0 30px 50px rgba(10,19,13,.35))"><Phone screen="home" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · The cost of not knowing. Dark, because this is the dark you are
         running in. Second person: these are your people, not "every organisation". -->
    <section id="dark" style="background:#0A130D;color:#F4F2E6">
      <div style={`${wrap};padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,104px)`}>
        <h2 style={`${h2};max-width:15em;color:#F6F4E9`}>Somewhere in your organisation, this is happening today.</h2>

        <div style="position:relative;margin-top:40px">
          <div id="mtrack" data-r="mtrack" tabindex="0" aria-label="Moments, scroll sideways" style="display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding-bottom:4px;scrollbar-width:none">
            {moments.map((m) => (
              <figure data-slide style="flex:0 0 calc((100% - 28px) / 3);scroll-snap-align:start;margin:0;display:flex;flex-direction:column;gap:14px">
                <div style="position:relative;height:300px;border-radius:20px;border:1px solid rgba(228,240,214,.11);background:#070D08;overflow:hidden;padding:18px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center">
                  {m.kind === 'sick' && (
                    <div style="display:flex;flex-direction:column;gap:10px">
                      <span style="align-self:center;font:400 12px 'DM Mono',monospace;color:rgba(244,242,230,.5)">7:12 am</span>
                      <div style="padding:12px 14px;border-radius:16px;background:rgba(228,240,214,.07)">
                        <div style="font:600 12px 'DM Sans',sans-serif;color:#F6F4E9">Sam</div>
                        <div style="margin-top:4px;font:400 13px/1.45 'DM Sans',sans-serif;color:rgba(244,242,230,.82)">Morning. Not feeling great, won’t make it in today. Sorry 🤒</div>
                      </div>
                    </div>
                  )}
                  {m.kind === 'mondays' && (
                    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:5px">
                      {['M','T','W','T','F'].map((d) => <span style="text-align:center;font:500 10px 'DM Mono',monospace;color:rgba(244,242,230,.4)">{d}</span>)}
                      {Array.from({ length: 20 }).map((_, i) => (
                        <span style={`height:30px;border-radius:6px;background:${i % 5 === 0 && i < 15 ? 'rgba(231,142,113,.32)' : 'rgba(228,240,214,.05)'};display:flex;align-items:center;justify-content:center;font:500 9.5px 'DM Sans',sans-serif;color:#FBDFD0`}>{i % 5 === 0 && i < 15 ? 'Sick' : ''}</span>
                      ))}
                    </div>
                  )}
                  {m.kind === 'chat' && (
                    <div style="display:flex;flex-direction:column;gap:9px">
                      <span style="align-self:flex-start;padding:9px 13px;border-radius:16px 16px 16px 5px;background:rgba(228,240,214,.08);font:400 13px 'DM Sans',sans-serif;color:rgba(244,242,230,.85)">You good?</span>
                      <span style="align-self:flex-end;padding:9px 13px;border-radius:16px 16px 5px 16px;background:rgba(217,234,110,.16);font:400 13px 'DM Sans',sans-serif;color:#EAF79B">All good 👍</span>
                      <span style="margin-top:8px;padding:8px 12px;border-radius:999px;border:1px solid rgba(228,240,214,.1);font:400 12px 'DM Sans',sans-serif;color:rgba(244,242,230,.3);text-decoration:line-through;text-decoration-color:rgba(244,242,230,.25)">Honestly, I’m pretty burnt out</span>
                    </div>
                  )}
                  {m.kind === 'meet' && (
                    <div>
                      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px">
                        {Array.from({ length: 9 }).map((_, i) => (
                          <span style={`aspect-ratio:4/3;border-radius:6px;background:rgba(228,240,214,${i === 4 ? '.02' : '.07'});position:relative`}><span style="position:absolute;right:5px;bottom:5px;width:6px;height:6px;border-radius:50%;background:rgba(231,142,113,.7)"></span></span>
                        ))}
                      </div>
                      <div style="margin-top:12px;padding:9px 12px;border-radius:12px;background:rgba(228,240,214,.05);font:400 12.5px 'DM Sans',sans-serif;color:rgba(244,242,230,.6)">“Any thoughts?” <span style="color:rgba(244,242,230,.32)">· no replies</span></div>
                    </div>
                  )}
                  {m.kind === 'mail' && (
                    <div style="display:flex;flex-direction:column;gap:12px">
                      {[0, 1].map(() => <span style="display:block;height:8px;width:70%;border-radius:4px;background:rgba(244,242,230,.07)"></span>)}
                      <div style="padding:12px 14px;border-radius:14px;background:rgba(228,240,214,.06);border-left:3px solid #E78E71">
                        <div style="font:600 13.5px 'DM Sans',sans-serif;color:#F6F4E9">Resignation</div>
                        <div style="margin-top:3px;font:400 12px 'DM Sans',sans-serif;color:rgba(244,242,230,.55)">Jordan Lee · 9:04 am</div>
                      </div>
                      {[0, 1].map(() => <span style="display:block;height:8px;width:56%;border-radius:4px;background:rgba(244,242,230,.05)"></span>)}
                    </div>
                  )}
                  {m.kind === 'exit' && (
                    <div style="display:flex;flex-direction:column;gap:10px">
                      <span style="font:500 10.5px 'DM Mono',monospace;letter-spacing:1.2px;color:rgba(244,242,230,.45)">EXIT INTERVIEW · NOTES</span>
                      <div style="font:400 20px/1.3 'DM Serif Display',serif;color:#F6F4E9">“It wasn’t one thing. It just built up.”</div>
                      <span style="font:400 12px 'DM Sans',sans-serif;color:rgba(244,242,230,.45)">Two years, eleven months</span>
                    </div>
                  )}
                </div>
                <figcaption style="display:flex;flex-direction:column;gap:5px">
                  <span style="font:600 11px 'DM Sans',sans-serif;letter-spacing:1.6px;color:#DCEC85">{m.cost.toUpperCase()}</span>
                  <span style="font:400 18px/1.3 'DM Serif Display',serif;color:#F6F4E9;text-wrap:pretty">{m.cap}</span>
                  <span style="font:400 14px/1.45 'DM Sans',sans-serif;color:rgba(201,212,194,.8);text-wrap:pretty">{m.line}</span>
                </figcaption>
              </figure>
            ))}
          </div>
          <div style="display:flex;align-items:center;gap:10px;margin-top:22px">
            <button id="mprev" type="button" aria-label="Previous moment" style="width:44px;height:44px;border-radius:999px;border:1px solid rgba(228,240,214,.18);background:transparent;color:#F4F2E6;font:400 18px 'DM Sans',sans-serif;cursor:pointer">‹</button>
            <button id="mnext" type="button" aria-label="Next moment" style="width:44px;height:44px;border-radius:999px;border:1px solid rgba(228,240,214,.18);background:transparent;color:#F4F2E6;font:400 18px 'DM Sans',sans-serif;cursor:pointer">›</button>
            <span id="mcount" aria-live="polite" style="margin-left:6px;font:500 12px 'DM Mono',monospace;color:rgba(201,212,194,.6)"></span>
          </div>
        </div>

        <div data-r="costs" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:clamp(48px,6vw,72px)">
          {costs.map((c) => (
            <div style="padding:22px 22px 20px;border-radius:22px 16px 24px 14px / 16px 24px 14px 22px;background:rgba(228,240,214,.045);border:1px solid rgba(228,240,214,.09)">
              <div style="font:600 11px 'DM Sans',sans-serif;letter-spacing:1.6px;color:rgba(201,212,194,.75)">{c.k.toUpperCase()}</div>
              <div style="margin-top:10px;font:400 36px/1 'DM Serif Display',serif;color:#F6F4E9">{c.v}</div>
              <div style="margin-top:4px;font:400 13px 'DM Sans',sans-serif;color:rgba(201,212,194,.7)">a person, every year</div>
              <p style="margin:12px 0 0;font:400 14.5px/1.5 'DM Sans',sans-serif;color:rgba(244,242,230,.82);text-wrap:pretty">{c.d}</p>
            </div>
          ))}
        </div>
        <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:12px 28px;margin-top:22px">
          <p style="margin:0;font:400 18px/1.5 'DM Sans',sans-serif;color:#F6F4E9">Together, about <strong style="font-weight:600;color:#EAF79B">A$22,000 a person, every year.</strong></p>
          <a href="/#roi" style="font:600 14.5px 'DM Sans',sans-serif;color:#EAF79B;border-bottom:2px solid rgba(217,234,110,.45);padding-bottom:2px">Work it out for your organisation ›</a>
        </div>
        <p style="margin:10px 0 0;font:400 12px/1.5 'DM Sans',sans-serif;color:rgba(201,212,194,.55)">Industry benchmarks on a A$100,000 salary: AHRI Work Outlook 2025–26, ABS, APSC.</p>

        <div style="margin-top:clamp(56px,7vw,88px);max-width:40em">
          <h2 style={`${h2};color:#F6F4E9`}>Right now, you’re running in the dark.</h2>
          <p style={`margin:18px 0 0;${lede};color:rgba(201,212,194,.86)`}>
            An annual survey is a photograph of a year ago. An EAP is used by one in twenty. In between,
            nothing tells you which team is sliding, so you find out at the resignation.
          </p>
        </div>
      </div>
    </section>

    <!-- 3 · The turn. The page goes light here on purpose. -->
    <section style={`${wrap};padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(56px,7vw,88px)`}>
      <h2 style={`${h2};max-width:14em`}>nørma turns the lights on.</h2>
      <p style={`margin:18px 0 0;max-width:34em;${lede};color:${MUTED}`}>Every month, for every team. So you can see what’s going on, act on it, and know if it worked.</p>
      <ol data-r="steps" style="list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px">
        {[
          ['See what’s going on', 'Your people check in once a month. You see how every team is doing, as group figures, never a person’s answers.'],
          ['Act on it', 'nørma names the one place to look first, and gives you a session to run with that team.'],
          ['See if it moved', 'Next month tells you whether it worked. No more guessing, and no waiting a year to find out.'],
        ].map(([t, d], i) => (
          <li style={`padding-top:20px;border-top:2px solid ${i === 0 ? '#D3E45F' : 'rgba(20,35,26,.14)'}`}>
            <span style={`font:500 12px 'DM Mono',monospace;color:${MUTED}`}>0{i + 1}</span>
            <div style={`margin-top:8px;font:400 24px/1.2 'DM Serif Display',serif;color:${INK}`}>{t}</div>
            <p style={`margin:8px 0 0;font:400 15.5px/1.55 'DM Sans',sans-serif;color:${MUTED};text-wrap:pretty`}>{d}</p>
          </li>
        ))}
      </ol>
      <p style={`margin:44px 0 0;max-width:32em;font:400 19px/1.5 'DM Serif Display',serif;color:${INK}`}>And because the problem has two sides, so does nørma.</p>
    </section>

    <!-- 4 · Their side. Personal accountability: their life comes with them.
         Leads with the five pillars, because that is where they start. -->
    <section id="people" style={`background:${CREAM_2}`}>
      <div style={`${wrap};padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,104px)`}>
        <div data-r="split" style="display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(32px,5vw,72px);align-items:center">
          <div>
            <h2 style={`${h2};max-width:13em`}>Their life comes to work with them.</h2>
            <p style={`margin:18px 0 0;max-width:33em;${lede};color:${MUTED}`}>
              Work is one pillar of five. So nørma gives each person a companion that shows them where they are
              across all five, where the gaps are, and helps them work on them. It’s theirs. Nobody at work can read it.
            </p>
            <ul style="list-style:none;margin:32px 0 0;padding:0;display:flex;flex-direction:column">
              {PILLAR_HEADS.map((p, i) => (
                <li style="display:flex;align-items:center;gap:16px;padding:13px 0;border-top:1px solid rgba(20,35,26,.1)">
                  <span style={`flex:none;width:38px;height:38px;border-radius:${p.disc};background:#16261B;display:flex;align-items:center;justify-content:center;color:${p.fg}`}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={p.d1}></path>{p.d2 && <path d={p.d2}></path>}
                      {p.r1 ? <circle cx="9" cy="8.5" r={p.r1}></circle> : null}{p.r2 ? <circle cx="16.8" cy="10.3" r={p.r2}></circle> : null}
                    </svg>
                  </span>
                  <span style="display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px">
                    <span style={`font:500 16px 'DM Sans',sans-serif;color:${INK}`}>{PILLAR_NAMES[i]}</span>
                    <span style={`font:400 14.5px 'DM Sans',sans-serif;color:${MUTED}`}>{PILLAR_LINES[i]}</span>
                  </span>
                </li>
              ))}
            </ul>
            <p style={`margin:28px 0 0;max-width:33em;font:400 16px/1.6 'DM Sans',sans-serif;color:${INK};text-wrap:pretty`}>
              A monthly check-in shows them where they stand. Then they work on it in the moments in between:
              reflections they can say out loud, habits, short illustrated chapters, and <strong style="font-weight:600">Reset</strong>, breath work and short
              practices for when they need to settle.
            </p>
            <a href="/draft/your-people/" style={`display:inline-block;margin-top:26px;font:600 15px 'DM Sans',sans-serif;color:${INK};border-bottom:2px solid #D3E45F;padding-bottom:3px`}>See the whole app ›</a>
          </div>
          <div style="display:flex;justify-content:center">
            <div style="width:290px;flex:none;filter:drop-shadow(0 40px 60px rgba(20,35,26,.25))"><Phone screen="home" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Your side. Organisational responsibility for the culture, shown with
         the new dashboard (nørma Score, handoff 14 Oct). -->
    <section id="leaders" style="background:#0A130D;color:#F4F2E6">
      <div style={`${wrap};padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,104px)`}>
        <h2 style={`${h2};max-width:14em;color:#F6F4E9`}>The culture they walk into is yours to shape.</h2>
        <p style={`margin:18px 0 0;max-width:36em;${lede};color:rgba(201,212,194,.86)`}>
          Everything your people share flows into one number for each group, the nørma Score, made of two
          halves: how their lives are going, and how your culture is. You see where to look first, and what to do.
        </p>
        <div data-r="culture" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:26px">
          {['Do you feel heard?', 'Do you feel valued?', 'Do you feel safe to speak your truth?'].map((q, i) => (
            <span style="display:inline-flex;align-items:center;gap:10px;padding:9px 16px 9px 10px;border-radius:999px;background:rgba(228,240,214,.06);border:1px solid rgba(228,240,214,.1);font:400 14.5px 'DM Sans',sans-serif;color:#F4F2E6">
              <span style="width:24px;height:24px;border-radius:52% 48% 50% 50% / 50% 54% 46% 50%;background:rgba(228,240,214,.1);display:flex;align-items:center;justify-content:center;color:rgba(244,242,230,.85)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CULTURE_HEADS[i].d1}></path>{CULTURE_HEADS[i].d2 && <path d={CULTURE_HEADS[i].d2}></path>}</svg>
              </span>{q}
            </span>
          ))}
        </div>
