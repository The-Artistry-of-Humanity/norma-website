---
/* Dark top menu for the help centre, legal pages and 404 (the round 5 pages
   carry their own cream header). Links match the round 5 site; "Help centre"
   turns lime on /help.
   The burger menu takes over below 900px, where the links hide. */
interface Props { home?: boolean; current?: 'help' }
const { home = false, current } = Astro.props;
const p = home ? '' : '/';
const links = [
  { href: '/your-people/', label: 'Your people' },
  { href: '/for-leaders/', label: 'For leaders' },
  { href: '/roi/', label: 'ROI' },
  { href: '/help/', label: 'Help centre', key: 'help' },
];
const demo = '/book-a-demo/';
---
<div style="position:sticky;top:0;z-index:50;background:rgba(12,20,13,.82);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid rgba(228,240,214,.06)">
  <div data-r="wrap" style="max-width:1180px;margin:0 auto;padding:0 40px;height:68px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:24px">
    <a href={home ? '#top' : '/'} class="hv-logo" style="display:flex;align-items:center;gap:10px;flex:none;transition:all .2s ease"><img src="/assets/v5/norma-icon.png" alt="" style="width:30px;height:30px;border-radius:9px" /><span style="font:400 23px 'DM Serif Display',serif;color:#F6F4E9">nørma</span></a>
    <div data-r="navlinks" style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px 20px;min-width:0;font:500 14px 'DM Sans',sans-serif">
      {links.map((l) => (
        <a href={l.href} class="hv-link" aria-current={l.key && l.key === current ? 'page' : undefined} style={`color:${l.key && l.key === current ? '#EAF79B' : 'rgba(244,242,230,.8)'};transition:all .2s ease`}>{l.label}</a>
      ))}
    </div>
    <div style="display:flex;align-items:center;gap:20px;flex:none;white-space:nowrap">
      <a href={demo} class="hv-btn-primary" style="display:inline-flex;align-items:center;padding:11px 20px;border-radius:999px;background:linear-gradient(180deg,#E9F693,#D3E45F);font:600 13.5px 'DM Sans',sans-serif;color:#152213;box-shadow:inset 0 1px 0 rgba(255,255,255,.45);transition:all .2s ease">Book a demo</a>
      <button data-r="burger" aria-label="Open menu" aria-expanded="false" id="nrm-burger" style="display:none;width:40px;height:40px;border-radius:12px;border:1px solid rgba(228,240,214,.16);background:rgba(228,240,214,.05);cursor:pointer;align-items:center;justify-content:center;padding:0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4F2E6" stroke-width="2" stroke-linecap="round"><path d="M4 7 H20"></path><path d="M4 12 H20"></path><path d="M4 17 H20"></path></svg></button>
    </div>
  </div>
</div>

<div id="nrm-menu" hidden style="position:fixed;inset:0;z-index:60;background:rgba(7,13,8,.55);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)">
  <div style="position:absolute;top:0;left:0;right:0;background:rgba(12,20,13,.97);border-bottom:1px solid rgba(228,240,214,.10);padding:0 20px 26px;box-shadow:0 30px 60px rgba(0,0,0,.5)">
    <div style="height:68px;display:flex;align-items:center;justify-content:space-between">
      <span style="display:flex;align-items:center;gap:10px"><img src="/assets/v5/norma-icon.png" alt="" style="width:30px;height:30px;border-radius:9px" /><span style="font:400 23px 'DM Serif Display',serif;color:#F6F4E9">nørma</span></span>
      <button id="nrm-menu-close" aria-label="Close menu" style="width:40px;height:40px;border-radius:12px;border:1px solid rgba(228,240,214,.16);background:rgba(228,240,214,.05);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4F2E6" stroke-width="2" stroke-linecap="round"><path d="M6 6 L18 18"></path><path d="M18 6 L6 18"></path></svg></button>
    </div>
    <nav style="display:flex;flex-direction:column;margin-top:6px;font:500 17px 'DM Sans',sans-serif">
      {links.map((l) => (
        <a href={l.href} class="hv-link" style={`color:${l.key && l.key === current ? '#EAF79B' : 'rgba(244,242,230,.9)'};padding:13px 0;border-bottom:1px solid rgba(228,240,214,.07);transition:all .2s ease`}>{l.label}</a>
      ))}
    </nav>
    <a href={demo} class="hv-btn-primary" style="display:flex;align-items:center;justify-content:center;margin-top:20px;padding:15px 26px;border-radius:999px;background:linear-gradient(180deg,#E9F693,#D3E45F);font:600 15px 'DM Sans',sans-serif;color:#152213;box-shadow:inset 0 1px 0 rgba(255,255,255,.45),0 10px 30px rgba(217,234,110,.28);transition:all .2s ease">Book a demo</a>
  </div>
</div>

<script is:inline>
  (function () {
    var burger = document.getElementById('nrm-burger');
    var menu = document.getElementById('nrm-menu');
    var close = document.getElementById('nrm-menu-close');
    if (!burger || !menu || !close) return;
    function setOpen(open) {
      menu.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    }
    burger.addEventListener('click', function () { setOpen(menu.hidden); });
    close.addEventListener('click', function () { setOpen(false); });
    menu.addEventListener('click', function (e) {
      if (e.target === menu || (e.target instanceof Element && e.target.closest('a'))) setOpen(false);
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
  })();
</script>
