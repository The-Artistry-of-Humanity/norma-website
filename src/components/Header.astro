---
/* Dark top menu for the help centre, legal pages and 404: the round 5 header
   (rounded glass bar, lime underline on the current page, Book a demo pill,
   two-line menu button and inline menu under 760px) in the brand dark green. */
interface Props { home?: boolean; current?: 'help' }
const { current } = Astro.props;
const links = [
  { href: '/your-people/', label: 'Your people' },
  { href: '/for-leaders/', label: 'For leaders' },
  { href: '/roi/', label: 'ROI' },
];
// Help lives in the footer only (Oct 2026); `current` is kept for pages that pass it.
---
<header class="nh">
  <div class="nh-bar">
    <a href="/" class="nh-logo"><img src="/assets/v5/norma-icon.png" alt="" width="30" height="30" /><span>nørma</span></a>
    <div class="nh-right">
      <nav class="nh-links" aria-label="Main">
        {links.map((l) => <a href={l.href} aria-current={l.key && l.key === current ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <a href="/book-a-demo/" class="nh-demo">Book a demo</a>
      <button type="button" class="nh-burger" id="nh-burger" aria-label="Menu" aria-expanded="false" aria-controls="nh-menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"></path><path d="M4 16h16"></path></svg>
      </button>
    </div>
  </div>
  <nav class="nh-menu" id="nh-menu" hidden aria-label="Main">
    {links.map((l) => <a href={l.href} aria-current={l.key && l.key === current ? 'page' : undefined}>{l.label}</a>)}
  </nav>
</header>

<style>
  .nh{position:sticky;top:0;z-index:60;border-radius:0 0 26px 20px / 0 0 20px 26px;background:linear-gradient(180deg,rgba(22,44,30,.84),rgba(15,32,21,.74));backdrop-filter:blur(22px) saturate(160%);-webkit-backdrop-filter:blur(22px) saturate(160%);box-shadow:inset 0 -1px 0 rgba(228,240,214,.08),0 10px 30px -18px rgba(0,0,0,.6)}
  .nh-bar{max-width:1200px;margin:0 auto;padding:0 clamp(20px,5vw,48px);box-sizing:border-box;height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .nh-logo{display:flex;align-items:center;gap:10px;color:#F6F4E9}
  .nh-logo img{display:block;border-radius:9px}
  .nh-logo span{font:400 23px/1 'DM Serif Display',serif;letter-spacing:-.2px}
  .nh-logo:hover{color:#F6F4E9}
  .nh-right{display:flex;align-items:center;gap:28px}
  .nh-links{display:flex;align-items:center;gap:28px;font:500 14px 'DM Sans',sans-serif}
  .nh-links a{color:rgba(244,242,230,.72);transition:color .2s ease}
  .nh-links a:hover{color:#F6F4E9}
  .nh-links a[aria-current=page]{color:#F6F4E9;padding:4px 0 2px;border-bottom:2px solid #D3E45F}
  .nh-demo{display:inline-flex;align-items:center;height:44px;padding:0 16px;white-space:nowrap;border-radius:999px;background:linear-gradient(180deg,#E9F693,#D3E45F);color:#152213;font:600 13px 'DM Sans',sans-serif;box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 10px 26px rgba(217,234,110,.22);transition:transform .15s ease}
  .nh-demo:hover{color:#152213}
  .nh-demo:active{transform:scale(.985)}
  .nh-burger{display:none;width:40px;height:40px;margin-left:-18px;border-radius:999px;border:1px solid rgba(228,240,214,.18);background:transparent;align-items:center;justify-content:center;color:#F4F2E6;cursor:pointer;padding:0}
  .nh-menu{padding:8px clamp(20px,5vw,48px) 20px;display:flex;flex-direction:column;border-top:1px solid rgba(228,240,214,.08);font:400 22px 'DM Serif Display',serif}
  .nh-menu[hidden]{display:none}
  .nh-menu a{padding:12px 0;border-bottom:1px solid rgba(228,240,214,.08);color:#F6F4E9}
  .nh-menu a:last-child{border-bottom:0}
  .nh-menu a[aria-current=page]{color:#EAF79B}
  @media (max-width:759px){
    .nh-links{display:none}
    .nh-burger{display:flex}
  }
  @media (min-width:760px){ .nh-menu{display:none!important} }
</style>

<script is:inline>
  (function () {
    var b = document.getElementById('nh-burger'), m = document.getElementById('nh-menu');
    if (!b || !m) return;
    function set(open) { m.hidden = !open; b.setAttribute('aria-expanded', String(open)); }
    b.addEventListener('click', function () { set(m.hidden); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
</script>
