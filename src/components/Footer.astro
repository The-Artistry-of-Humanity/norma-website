---
/* Shared footer (handoff v3 §1.6): PRODUCT / TRUST / TALK columns, with the
   legal links in their own muted row under a hairline. */
interface Props { home?: boolean }
const { home = false } = Astro.props;
const p = home ? '' : '/';
const col = "display:flex;flex-direction:column;gap:10px;font:400 13.5px 'DM Sans',sans-serif";
const head = "font:600 9px 'DM Sans',sans-serif;letter-spacing:2px;color:rgba(201,212,194,.78)";
const link = 'color:rgba(244,242,230,.85);transition:all .2s ease';
---
<div style="border-top:1px solid rgba(228,240,214,.08)">
  <div data-r="wrap" style="max-width:1180px;margin:0 auto;padding:40px 40px 56px;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:28px">
    <div style="max-width:360px">
      <div style="display:flex;align-items:center;gap:10px"><img src="/assets/norma-logo.png" alt="" style="width:26px;height:26px;border-radius:8px" /><span style="font:400 20px 'DM Serif Display',serif;color:#F6F4E9">nørma</span></div>
      <p style="margin:12px 0 0;font:400 13.5px/1.5 'DM Sans',sans-serif;color:rgba(201,212,194,.78)">A well-being operating system by Artistry of Humanity. Built with 💚 in Australia.</p>
      <p style="margin:14px 0 0;font:400 12px/1.55 'DM Sans',sans-serif;color:rgba(201,212,194,.72)">nørma is not a medical device, a diagnosis or a therapy tool. It supports, and does not replace, an organisation’s well-being and psychosocial processes.</p>
    </div>
    <div style="display:flex;gap:56px;flex-wrap:wrap">
      <div style={col}>
        <span style={head}>PRODUCT</span>
        <a href={`${p}#product`} class="hv-link" style={link}>Two sides</a>
        <a href={`${p}#pillars`} class="hv-link" style={link}>Five pillars</a>
        <a href={`${p}#leaders`} class="hv-link" style={link}>For leaders</a>
        <a href={`${p}#journeys`} class="hv-link" style={link}>Growth Journeys</a>
      </div>
      <div style={col}>
        <span style={head}>TRUST</span>
        <a href={`${p}#privacy`} class="hv-link" style={link}>Privacy</a>
        <a href={`${p}#duty`} class="hv-link" style={link}>Psychosocial duty</a>
        <a href="/help" class="hv-link" style={link}>Help centre</a>
      </div>
      <div style={col}>
        <span style={head}>TALK</span>
        <a href={`${p}#demo`} class="hv-link" style={link}>Book a demo</a>
      </div>
    </div>
  </div>
  <div data-r="wrap" style="max-width:1180px;margin:0 auto;padding:18px 40px 28px;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 28px;border-top:1px solid rgba(228,240,214,.06);font:400 12.5px 'DM Sans',sans-serif;color:rgba(201,212,194,.62)">
    <span>© 2026 The Artistry of Humanity Pty Ltd</span>
    <span style="display:flex;flex-wrap:wrap;gap:20px">
      <a href="/privacy" class="hv-link" style="color:rgba(201,212,194,.75);transition:all .2s ease">Privacy policy</a>
      <a href="/terms" class="hv-link" style="color:rgba(201,212,194,.75);transition:all .2s ease">Terms of use</a>
    </span>
  </div>
</div>
