---
/* Dark footer for the help centre, legal pages and 404: the round 5 footer
   (logo and links, then the legal row under a hairline) in the brand dark
   green, plus the not-a-medical-device note and the urgent support link. */
import { BY } from '../data/help';
interface Props { home?: boolean }
---
<footer class="nf">
  <div class="nf-wrap">
    <div class="nf-top">
      <a href="/" class="nf-logo"><img src="/assets/v5/norma-icon.png" alt="" width="26" height="26" /><span>nørma</span></a>
      <nav class="nf-links" aria-label="Footer">
        <a href="/your-people/">Your people</a>
        <a href="/for-leaders/">For leaders</a>
        <a href="/roi/">ROI</a>
        <a href="/our-story/">Our story</a>
        <a href="/help/">Help</a>
        <a href="/book-a-demo/">Book a demo</a>
      </nav>
    </div>
    <p class="nf-note">nørma is not a medical device, a diagnosis or a therapy tool. It supports, and does not replace, an organisation’s well-being and psychosocial processes.</p>
    <div class="nf-legal">
      <span>© 2026 The Artistry of Humanity Pty Ltd</span>
      <span class="nf-legal-links">
        <a href="/privacy/">Privacy policy</a>
        <a href="/terms/">Terms of use</a>
        <a href="/help/">Help centre</a>
        <a href={BY['a-crisis'].url}>Urgent support</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .nf{border-top:1px solid rgba(228,240,214,.08)}
  .nf-wrap{max-width:1200px;margin:0 auto;padding:36px clamp(20px,5vw,48px) 40px;box-sizing:border-box;display:flex;flex-direction:column;gap:24px}
  .nf-top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px 32px}
  .nf-logo{display:flex;align-items:center;gap:10px;color:#F6F4E9}
  .nf-logo:hover{color:#F6F4E9}
  .nf-logo img{display:block;border-radius:8px}
  .nf-logo span{font:400 20px/1 'DM Serif Display',serif}
  .nf-links{display:flex;flex-wrap:wrap;gap:12px 28px;font:500 14px 'DM Sans',sans-serif}
  .nf-links a,.nf-legal a{color:rgba(244,242,230,.72);transition:color .2s ease}
  .nf-links a:hover,.nf-legal a:hover{color:#F6F4E9}
  .nf-note{margin:0;max-width:46em;font:400 12.5px/1.55 'DM Sans',sans-serif;color:rgba(201,212,194,.62)}
  .nf-legal{display:flex;flex-wrap:wrap;gap:10px 28px;justify-content:space-between;padding-top:20px;border-top:1px solid rgba(228,240,214,.08);font:400 12.5px 'DM Sans',sans-serif;color:rgba(201,212,194,.66)}
  .nf-legal-links{display:flex;flex-wrap:wrap;gap:8px 20px}
  .nf-legal a{color:rgba(201,212,194,.72)}
</style>
